@using LibraryManagement.Models
@model IList<tblCategory>

@{
    ViewData["Title"] = "Quản lý Danh mục Thể loại";
    var bookCounts = ViewBag.BookCounts as Dictionary<int, int>;
}

<main id="main" class="main">
    <div class="pagetitle mb-3">
        <h2>Quản lý Danh mục Thể loại</h2>
        <p class="text-muted small mb-0">Theo dõi danh mục sách, kiểm soát quan hệ khóa ngoại và bảo toàn dữ liệu bằng cơ chế Xóa mềm.</p>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <section class="section dashboard">
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="fw-bold text-dark mb-0">Danh sách thể loại sách (@Model.Count)</h5>
                            <a class="btn btn-success rounded-pill px-4 py-2 fw-semibold shadow-sm" asp-area="Admin" asp-controller="Category" asp-action="Create">
                                <i class="bi bi-plus-circle me-1"></i> Thêm mới thể loại
                            </a>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" style="font-size: 13.5px;">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-center" style="width: 60px;">ID</th>
                                        <th>Tên thể loại</th>
                                        <th>Mô tả</th>
                                        <th class="text-center">Sách liên kết</th>
                                        <th class="text-center">Trạng thái</th>
                                        <th class="text-center" style="width: 140px;">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        int count = (bookCounts != null && bookCounts.ContainsKey(item.CategoryID)) ? bookCounts[item.CategoryID] : 0;
                                        <tr class="@(item.IsActive != true ? "table-light opacity-75" : "")">
                                            <td class="text-center text-muted fw-bold">#@item.CategoryID</td>
                                            <td>
                                                <strong class="text-dark">@item.CategoryName</strong>
                                            </td>
                                            <td class="text-muted">@(string.IsNullOrWhiteSpace(item.Description) ? "---" : item.Description)</td>
                                            <td class="text-center">
                                                @if (count > 0)
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                                                        @count đầu sách
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted border rounded-pill px-2 py-1">
                                                        0 sách
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (item.IsActive == true)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Hiển thị</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1" title="Đã xóa mềm">Ẩn (Xóa mềm)</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="d-flex gap-1 justify-content-center">
                                                    <a asp-area="Admin" asp-controller="Category" asp-action="Edit" asp-route-id="@item.CategoryID" 
                                                       class="btn btn-outline-primary btn-sm rounded-circle d-inline-flex align-items-center justify-content-center" 
                                                       style="width: 32px; height: 32px;" title="Sửa thể loại">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>

                                                    <!-- Toggle Active / Soft Delete -->
                                                    <form method="post" asp-area="Admin" asp-controller="Category" asp-action="ToggleActive" asp-route-id="@item.CategoryID" class="d-inline">
                                                        <button type="submit" class="btn btn-outline-secondary btn-sm rounded-circle d-inline-flex align-items-center justify-content-center" 
                                                                style="width: 32px; height: 32px;" 
                                                                title="@(item.IsActive == true ? "Ẩn thể loại (Xóa mềm)" : "Kích hoạt hiển thị")">
                                                            <i class="bi @(item.IsActive == true ? "bi-eye-slash" : "bi-eye")"></i>
                                                        </button>
                                                    </form>

                                                    <!-- Xóa có bảo toàn -->
                                                    <form method="post" asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@item.CategoryID" 
                                                          onsubmit="return confirm('Xác nhận xóa thể loại [@item.CategoryName]? Nếu đang có sách liên kết, hệ thống sẽ tự động chuyển sang chế độ Xóa mềm để bảo toàn dữ liệu.');" 
                                                          class="d-inline">
                                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle d-inline-flex align-items-center justify-content-center" 
                                                                style="width: 32px; height: 32px;" title="Xóa thể loại">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
