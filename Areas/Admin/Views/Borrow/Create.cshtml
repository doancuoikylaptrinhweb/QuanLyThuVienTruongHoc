@using LibraryManagement.Models
@model tblBorrowTicket

@{
    ViewData["Title"] = "Lập Phiếu Mượn Sách Mới";
    var availableBooks = ViewBag.AvailableBooks as List<tblBook> ?? new List<tblBook>();
}

<main id="main" class="main">
    <div class="pagetitle mb-3">
        <h2>Lập Phiếu Mượn Sách Mới</h2>
        <p class="text-muted small mb-0">Hỗ trợ mượn một hoặc nhiều đầu sách trong cùng một phiếu mượn. Hệ thống kiểm tra tồn kho bằng thao tác cập nhật nguyên tử và bảo toàn giao dịch ACID.</p>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form method="post" asp-area="Admin" asp-controller="Borrow" asp-action="Create" id="createBorrowForm" onsubmit="return validateBorrowForm()">
        <div class="row g-4">
            <!-- Cột trái: Thông tin phiếu & Độc giả -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-person-badge-fill text-primary"></i> Thông Tin Độc Giả &amp; Thời Hạn
                    </h5>

                    <!-- Tìm & Chọn độc giả theo mã hoặc tên -->
                    <div class="mb-3 position-relative">
                        <label class="form-label fw-bold">Chọn Độc giả mượn <span class="text-danger">*</span></label>
                        <input type="hidden" asp-for="UserID" id="selectedUserId" />

                        <div class="input-group">
                            <span class="input-group-text bg-light text-primary"><i class="bi bi-search"></i></span>
                            <input type="text"
                                   id="readerSearchInput"
                                   class="form-control"
                                   autocomplete="off"
                                   placeholder="Nhập mã độc giả (VD: DG0001) hoặc tên độc giả..." />
                            <button type="button"
                                    id="btnClearReaderSearch"
                                    class="btn btn-outline-secondary d-none"
                                    onclick="clearSelectedReader()"
                                    title="Xóa lựa chọn độc giả">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <small class="text-muted">Nhập mã độc giả (<code>DG...</code>), tên đăng nhập hoặc họ tên rồi chọn đúng độc giả bên dưới.</small>

                        <!-- Thông báo kiểm tra / không tìm thấy -->
                        <div id="readerSearchMessage" class="alert alert-warning py-2 px-3 small rounded-3 mt-2 mb-0 d-none"></div>

                        <!-- Danh sách kết quả tìm kiếm phù hợp -->
                        <div id="readerSearchResults"
                             class="list-group shadow-sm rounded-3 mt-2 d-none"
                             style="max-height: 240px; overflow-y: auto; border: 1px solid #e2e8f0;">
                        </div>

                        <!-- Thẻ xác nhận thông tin độc giả đã chọn -->
                        <div id="selectedReaderCard" class="p-3 rounded-4 border border-primary-subtle bg-primary-subtle bg-opacity-10 mt-2 d-none">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-primary" id="selReaderCode">DG0000</span>
                                        <strong class="text-dark" id="selReaderName">...</strong>
                                        <span class="badge bg-white text-secondary border" id="selReaderRole">Độc giả</span>
                                    </div>
                                    <div class="text-muted small" id="selReaderMeta">...</div>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0" onclick="clearSelectedReader()">
                                    Đổi
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Mã phiếu mượn -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mã phiếu mượn</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-upc-scan"></i></span>
                            <input type="text" class="form-control" asp-for="TicketCode" placeholder="@ViewBag.PreviewTicketCode (Để trống để tự sinh mã)">
                        </div>
                        <small class="text-muted">Mặc định hệ thống tự động sinh mã dạng <code>PM000X</code></small>
                    </div>

                    <!-- Hạn trả sách -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Hạn phải trả sách <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" asp-for="DueDate" value="@DateTime.Now.AddDays(14).ToString("yyyy-MM-dd")" required>
                        <small class="text-muted">Thời hạn mượn tiêu chuẩn: 14 ngày</small>
                    </div>

                    <!-- Ghi chú mượn -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ghi chú tình trạng</label>
                        <textarea class="form-control" asp-for="Note" rows="2" placeholder="Ví dụ: Độc giả mượn phục vụ làm đồ án, sách mới nguyên bìa..."></textarea>
                    </div>

                    <div class="alert alert-light border small text-muted rounded-3 mt-auto">
                        <i class="bi bi-shield-lock text-primary me-1"></i>
                        Hệ thống tự động trừ kho nguyên tử <code>AvailableQuantity - 1</code> trong Transaction, chống xung đột mượn trùng cuốn cuối cùng.
                    </div>
                </div>
            </div>

            <!-- Cột phải: Chọn danh sách sách mượn -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 d-flex flex-column">
                    <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-bookshelf text-primary"></i> Danh Sách Sách Mượn Chi Tiết
                    </h5>

                    <!-- Thanh chọn thêm sách nhanh -->
                    <div class="p-3 bg-light rounded-4 border mb-3">
                        <label class="form-label fw-semibold small text-dark mb-1">Chọn sách có sẵn trên kệ và bấm thêm:</label>
                        <div class="d-flex gap-2">
                            <select id="bookPickerSelect" class="form-select">
                                <option value="">-- Chọn cuốn sách cần thêm --</option>
                                @foreach (var b in availableBooks)
                                {
                                    <option value="@b.BookID" data-code="@b.Code" data-title="@b.Title" data-avail="@b.AvailableQuantity">
                                        [@b.Code] @b.Title (Còn @b.AvailableQuantity bản)
                                    </option>
                                }
                            </select>
                            <button type="button" class="btn btn-primary px-3 fw-semibold text-nowrap d-flex align-items-center gap-1" onclick="addBookToBorrowList()">
                                <i class="bi bi-plus-lg"></i> Thêm sách
                            </button>
                        </div>
                    </div>

                    <!-- Bảng sách đã chọn -->
                    <div class="table-responsive flex-grow-1 border rounded-3 mb-3 bg-white" style="min-height: 200px;">
                        <table class="table table-hover align-middle mb-0" style="font-size: 13.5px;">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 100px;">Mã sách</th>
                                    <th>Tên sách mượn</th>
                                    <th class="text-center" style="width: 110px;">Khả dụng</th>
                                    <th class="text-center" style="width: 80px;">Xóa</th>
                                </tr>
                            </thead>
                            <tbody id="selectedBooksTableBody">
                                <tr id="emptyBooksRow">
                                    <td colspan="4" class="text-center py-4 text-muted">
                                        <i class="bi bi-journal-plus fs-3 d-block mb-1 opacity-50"></i>
                                        Chưa có cuốn sách nào được chọn. Vui lòng chọn sách từ danh sách phía trên.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Tổng kết & Nút hành động -->
                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <div class="text-dark small">
                            Đã chọn: <strong id="selectedBooksCount" class="text-primary fs-6">0</strong> cuốn sách
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-area="Admin" asp-controller="Borrow" asp-action="Index" class="btn btn-secondary rounded-pill px-4">
                                Hủy bỏ
                            </a>
                            <button type="submit" id="btnSubmitBorrow" class="btn btn-success rounded-pill px-4 fw-semibold shadow-sm" disabled>
                                <i class="bi bi-journal-check me-1"></i> Xác nhận lập phiếu mượn
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</main>

<script>
    var selectedBookIds = [];
    var readerSearchTimer = null;

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    document.addEventListener("DOMContentLoaded", function () {
        var input = document.getElementById("readerSearchInput");
        if (!input) return;

        input.addEventListener("input", function () {
            // Nếu admin sửa lại ô tìm kiếm, xóa lựa chọn cũ để tránh chọn nhầm độc giả
            document.getElementById("selectedUserId").value = "";
            document.getElementById("selectedReaderCard").classList.add("d-none");
            document.getElementById("readerSearchMessage").classList.add("d-none");

            var keyword = input.value.trim();
            var clearBtn = document.getElementById("btnClearReaderSearch");
            if (keyword.length > 0) clearBtn.classList.remove("d-none");
            else clearBtn.classList.add("d-none");

            clearTimeout(readerSearchTimer);
            if (!keyword) {
                hideReaderResults();
                return;
            }

            readerSearchTimer = setTimeout(function () {
                performReaderSearch(keyword);
            }, 200);
        });

        input.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                var keyword = input.value.trim();
                if (keyword) {
                    clearTimeout(readerSearchTimer);
                    performReaderSearch(keyword);
                }
            }
        });
    });

    function performReaderSearch(keyword) {
        var resultsEl = document.getElementById("readerSearchResults");
        var msgEl = document.getElementById("readerSearchMessage");

        fetch('/Admin/Borrow/SearchReaders?keyword=' + encodeURIComponent(keyword))
            .then(function (res) { return res.json(); })
            .then(function (res) {
                var list = (res && res.data) ? res.data : [];
                if (list.length === 0) {
                    hideReaderResults();
                    msgEl.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i> Không tìm thấy độc giả nào hợp lệ với từ khóa "<strong>' + escapeHtml(keyword) + '</strong>".';
                    msgEl.classList.remove("d-none");
                    return;
                }

                msgEl.classList.add("d-none");
                var html = "";
                list.forEach(function (u) {
                    var subInfo = [];
                    if (u.userName) subInfo.push('Tài khoản: ' + escapeHtml(u.userName));
                    if (u.email) subInfo.push(escapeHtml(u.email));

                    html += '<button type="button" class="list-group-item list-group-item-action py-2 px-3 d-flex justify-content-between align-items-center" ' +
                        'onclick=\'selectReader(' + JSON.stringify(u) + ')\'>' +
                        '<div class="text-start">' +
                        '<div class="d-flex align-items-center gap-2">' +
                        '<span class="badge bg-primary-subtle text-primary border">' + escapeHtml(u.code) + '</span>' +
                        '<span class="fw-semibold text-dark">' + escapeHtml(u.fullName) + '</span>' +
                        '</div>' +
                        '<small class="text-muted">' + subInfo.join(' • ') + '</small>' +
                        '</div>' +
                        '<span class="badge bg-light text-secondary border">' + escapeHtml(u.roleLabel) + '</span>' +
                        '</button>';
                });

                resultsEl.innerHTML = html;
                resultsEl.classList.remove("d-none");
            })
            .catch(function () {
                hideReaderResults();
                msgEl.innerHTML = '<i class="bi bi-wifi-off me-1"></i> Không thể tìm kiếm độc giả lúc này, vui lòng thử lại.';
                msgEl.classList.remove("d-none");
            });
    }

    function selectReader(u) {
        document.getElementById("selectedUserId").value = u.userId;
        document.getElementById("readerSearchInput").value = "[" + u.code + "] " + u.fullName;
        document.getElementById("btnClearReaderSearch").classList.remove("d-none");
        document.getElementById("readerSearchMessage").classList.add("d-none");
        hideReaderResults();

        document.getElementById("selReaderCode").textContent = u.code;
        document.getElementById("selReaderName").textContent = u.fullName;
        document.getElementById("selReaderRole").textContent = u.roleLabel;

        var metaParts = [];
        if (u.userName) metaParts.push("Tài khoản: " + u.userName);
        if (u.email) metaParts.push("Email: " + u.email);
        document.getElementById("selReaderMeta").textContent = metaParts.join(" • ") || "Đã xác nhận thông tin bạn đọc";

        document.getElementById("selectedReaderCard").classList.remove("d-none");
    }

    function clearSelectedReader() {
        document.getElementById("selectedUserId").value = "";
        var input = document.getElementById("readerSearchInput");
        input.value = "";
        input.focus();
        document.getElementById("btnClearReaderSearch").classList.add("d-none");
        document.getElementById("selectedReaderCard").classList.add("d-none");
        document.getElementById("readerSearchMessage").classList.add("d-none");
        hideReaderResults();
    }

    function hideReaderResults() {
        var resultsEl = document.getElementById("readerSearchResults");
        resultsEl.innerHTML = "";
        resultsEl.classList.add("d-none");
    }

    function addBookToBorrowList() {
        var select = document.getElementById("bookPickerSelect");
        var bookId = select.value;
        if (!bookId) {
            alert("Vui lòng chọn một cuốn sách từ danh sách!");
            return;
        }

        if (selectedBookIds.includes(bookId)) {
            alert("Cuốn sách này đã có trong danh sách mượn của phiếu!");
            return;
        }

        var option = select.options[select.selectedIndex];
        var code = option.getAttribute("data-code");
        var title = option.getAttribute("data-title");
        var avail = option.getAttribute("data-avail");

        selectedBookIds.push(bookId);
        renderSelectedBooksTable();
        select.value = "";
    }

    function removeBookFromList(bookId) {
        selectedBookIds = selectedBookIds.filter(id => id !== String(bookId));
        renderSelectedBooksTable();
    }

    function renderSelectedBooksTable() {
        var tbody = document.getElementById("selectedBooksTableBody");
        var countSpan = document.getElementById("selectedBooksCount");
        var submitBtn = document.getElementById("btnSubmitBorrow");

        countSpan.textContent = selectedBookIds.length;

        if (selectedBookIds.length === 0) {
            tbody.innerHTML = '<tr id="emptyBooksRow">' +
                '<td colspan="4" class="text-center py-4 text-muted">' +
                '<i class="bi bi-journal-plus fs-3 d-block mb-1 opacity-50"></i>' +
                'Chưa có cuốn sách nào được chọn. Vui lòng chọn sách từ danh sách phía trên.' +
                '</td></tr>';
            submitBtn.disabled = true;
            return;
        }

        submitBtn.disabled = false;
        var html = "";
        var select = document.getElementById("bookPickerSelect");

        selectedBookIds.forEach(id => {
            var opt = select.querySelector('option[value="' + id + '"]');
            var code = opt ? opt.getAttribute("data-code") : "MS" + id;
            var title = opt ? opt.getAttribute("data-title") : "Sách #" + id;
            var avail = opt ? opt.getAttribute("data-avail") : "1";

            html += '<tr>' +
                '<td><span class="badge" style="background: #eef2ff; color: #4338ca; font-weight: 700;">' + code + '</span></td>' +
                '<td><strong>' + title + '</strong><input type="hidden" name="selectedBookIds" value="' + id + '" /></td>' +
                '<td class="text-center fw-semibold text-success">' + avail + ' bản</td>' +
                '<td class="text-center">' +
                '<button type="button" class="btn btn-outline-danger btn-sm rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 28px; height: 28px;" onclick="removeBookFromList(\'' + id + '\')" title="Xóa cuốn này">' +
                '<i class="bi bi-x-lg" style="font-size: 11px;"></i>' +
                '</button>' +
                '</td>' +
                '</tr>';
        });

        tbody.innerHTML = html;
    }

    function validateBorrowForm() {
        var userId = document.getElementById("selectedUserId").value;
        if (!userId || parseInt(userId, 10) <= 0) {
            var msgEl = document.getElementById("readerSearchMessage");
            msgEl.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Vui lòng tìm và chọn một độc giả hợp lệ từ danh sách kết quả!';
            msgEl.classList.remove("d-none");
            document.getElementById("readerSearchInput").focus();
            return false;
        }
        if (selectedBookIds.length === 0) {
            alert("Vui lòng chọn ít nhất một cuốn sách để lập phiếu mượn!");
            return false;
        }
        return true;
    }
</script>
