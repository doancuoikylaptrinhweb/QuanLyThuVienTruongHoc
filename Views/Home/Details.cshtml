@using LibraryManagement.Models
@model tblBook

@{
    var author = ViewBag.Author as tblAuthor;
    var category = ViewBag.Category as tblCategory;
    var publisher = ViewBag.Publisher as tblPublisher;
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Trang chủ</a></li>
        <li class="breadcrumb-item active">@Model.Title</li>
    </ol>
</nav>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4 p-md-5">
        <div class="row g-4">
            <!-- Cột trái: Ảnh bìa -->
            <div class="col-md-4 text-center">
                <img src="@(Model.Images != null && Model.Images.StartsWith("/") ? Model.Images : "/" + Model.Images)" 
                     class="img-fluid rounded shadow" alt="@Model.Title" style="max-height: 420px; object-fit: cover;">
                
                <div class="mt-4">
                    @if (Model.AvailableQuantity > 0)
                    {
                        <div class="alert alert-success d-inline-block px-4 py-2 mb-0">
                            <i class="bi bi-check-circle-fill me-1"></i> Còn <strong>@Model.AvailableQuantity</strong> cuốn trên kệ
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger d-inline-block px-4 py-2 mb-0">
                            <i class="bi bi-x-circle-fill me-1"></i> Tạm hết trên kệ sách
                        </div>
                    }
                </div>
            </div>

            <!-- Cột phải: Thông tin chi tiết -->
            <div class="col-md-8">
                <span class="badge bg-primary mb-2">@(category?.CategoryName ?? "Sách tham khảo")</span>
                <h2 class="fw-bold text-dark mb-3">@Model.Title</h2>

                <ul class="list-group list-group-flush mb-4">
                    <li class="list-group-item px-0">
                        <strong>Tác giả:</strong> @(author?.AuthorName ?? "Đang cập nhật")
                    </li>
                    <li class="list-group-item px-0">
                        <strong>Nhà xuất bản:</strong> @(publisher?.PublisherName ?? "Đang cập nhật")
                    </li>
                    <li class="list-group-item px-0">
                        <strong>Năm xuất bản:</strong> @Model.PublishYear
                    </li>
                    <li class="list-group-item px-0">
                        <strong>Tổng số lượng nhập kho:</strong> @Model.Quantity cuốn
                    </li>
                </ul>

                @if (!string.IsNullOrEmpty(Model.Summary))
                {
                    <h5 class="fw-bold mt-3">Tóm tắt sách:</h5>
                    <p class="text-muted fst-italic">@Model.Summary</p>
                }
            </div>
        </div>

        <hr class="my-5">

        <!-- Nội dung giới thiệu chi tiết (từ trình soạn thảo Summernote) -->
        <div>
            <h4 class="fw-bold mb-3"><i class="bi bi-card-text me-2"></i> Giới thiệu chi tiết nội dung</h4>
            <div class="p-3 bg-light rounded">
                @if (!string.IsNullOrEmpty(Model.Contents))
                {
                    @Html.Raw(Model.Contents)
                }
                else
                {
                    <p class="text-muted">Chưa có bài viết giới thiệu chi tiết cho cuốn sách này.</p>
                }
            </div>
        </div>

        <div class="mt-4">
            <a href="/" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>
</div>