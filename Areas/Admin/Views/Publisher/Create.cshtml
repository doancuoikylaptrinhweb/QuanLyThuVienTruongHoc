@using LibraryManagement.Models
@model tblPublisher

@{
    ViewData["Title"] = "Thêm Nhà Xuất Bản Mới";
}

<main id="main" class="main">

    <div class="pagetitle mb-4">
        <h4 class="fw-bold text-dark mb-0">Thêm Nhà Xuất Bản Mới</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0" style="font-size: 13px;">
                <li class="breadcrumb-item"><a href="/Admin/Home">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Admin/Publisher">Nhà xuất bản</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <form asp-area="Admin" asp-controller="Publisher" asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên nhà xuất bản <span class="text-danger">*</span></label>
                        <input asp-for="PublisherName" class="form-control" required placeholder="Ví dụ: NXB Giáo Dục, NXB Trẻ, NXB Kim Đồng..." />
                        <span asp-validation-for="PublisherName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Địa chỉ trụ sở</label>
                        <input asp-for="Address" class="form-control" placeholder="Ví dụ: 81 Trần Hưng Đạo, Hoàn Kiếm, Hà Nội" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Hotline / Số điện thoại</label>
                        <input asp-for="Phone" class="form-control" placeholder="Ví dụ: (024) 3822-0801" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                            <i class="bi bi-check-circle me-1"></i> Lưu Nhà Xuất Bản
                        </button>
                        <a asp-area="Admin" asp-controller="Publisher" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

</main>
