@using LibraryManagement.Models
@model IList<tblAuthor>

@{
    ViewData["Title"] = "Quản Lý Tác Giả";
    var bookCounts = ViewBag.BookCounts as Dictionary<int, int>;
}

<main id="main" class="main">

    <!-- Page Header & Action -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm" 
                 style="width: 44px; height: 44px; background: #2563eb; font-size: 20px;">
                <i class="bi bi-pen-fill"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-0 text-dark" style="font-size: 22px; letter-spacing: -0.3px;">Quản Lý Tác Giả Sách</h4>
                <small class="text-muted" style="font-size: 13px;">
                    Danh sách các tác giả, tiểu sử và thống kê số lượng sách liên kết trong thư viện
                </small>
            </div>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-area="Admin" asp-controller="Author" asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm d-flex align-items-center gap-2">
                <i class="bi bi-plus-circle-fill"></i> Thêm Tác Giả Mới
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="display-6 fw-bold text-dark lh-1 mb-2" style="font-size: 28px;">@ViewBag.TotalAuthors</div>
                        <div class="text-muted small">Tổng số tác giả</div>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: #eff6ff; color: #2563eb; font-size: 20px;">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="display-6 fw-bold text-success lh-1 mb-2" style="font-size: 28px;">@ViewBag.ActiveAuthors</div>
                        <div class="text-muted small">Đang kích hoạt</div>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: #ecfdf5; color: #059669; font-size: 20px;">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="display-6 fw-bold text-primary lh-1 mb-2" style="font-size: 28px;">
                            @(bookCounts != null ? bookCounts.Values.Sum() : 0)
                        </div>
                        <div class="text-muted small">Đầu sách được liên kết</div>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: #f5f3ff; color: #7c3aed; font-size: 20px;">
                        <i class="bi bi-book"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <!-- Search bar -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <form method="get" class="d-flex gap-2 flex-grow-1" style="max-width: 450px;">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control border-start-0 ps-0" placeholder="Tìm theo tên tác giả hoặc tiểu sử..." />
                </div>
                <button type="submit" class="btn btn-primary rounded-pill px-3">Tìm</button>
                @if (!string.IsNullOrEmpty(ViewBag.Keyword))
                {
                    <a href="/Admin/Author" class="btn btn-outline-secondary rounded-pill px-3">Xóa lọc</a>
                }
            </form>
            <div class="text-muted small">
                Hiển thị: <strong>@Model.Count</strong> tác giả
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 13.5px;">
                <thead>
                    <tr class="text-muted text-uppercase" style="font-size: 11px; letter-spacing: 0.6px; border-bottom: 2px solid #f1f5f9;">
                        <th class="py-2 text-center" style="width: 60px;"># ID</th>
                        <th class="py-2" style="width: 250px;">TÊN TÁC GIẢ</th>
                        <th class="py-2">TIỂU SỬ / GIỚI THIỆU</th>
                        <th class="py-2 text-center" style="width: 140px;">SỐ ĐẦU SÁCH</th>
                        <th class="py-2 text-center" style="width: 130px;">TRẠNG THÁI</th>
                        <th class="py-2 text-center" style="width: 140px;">CHỨC NĂNG</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                Không tìm thấy tác giả nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            int count = bookCounts != null && bookCounts.ContainsKey(item.AuthorID) ? bookCounts[item.AuthorID] : 0;
                            <tr>
                                <td class="text-center fw-semibold text-secondary">#@item.AuthorID</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-primary" style="width: 32px; height: 32px; background: #eff6ff;">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <strong class="text-dark">@item.AuthorName</strong>
                                    </div>
                                </td>
                                <td class="text-secondary">
                                    @(string.IsNullOrEmpty(item.Bio) ? "Chưa có thông tin tiểu sử" : (item.Bio.Length > 80 ? item.Bio.Substring(0, 80) + "..." : item.Bio))
                                </td>
                                <td class="text-center">
                                    <span class="badge" style="background: #eef2ff; color: #4338ca; font-weight: 600; padding: 6px 12px; border-radius: 50px;">
                                        @count đầu sách
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.IsActive == true)
                                    {
                                        <span class="badge" style="background: #dcfce7; color: #15803d; font-weight: 600; padding: 6px 12px; border-radius: 50px;">
                                            Hiển thị
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background: #fee2e2; color: #b91c1c; font-weight: 600; padding: 6px 12px; border-radius: 50px;">
                                            Ẩn
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex gap-1">
                                        <!-- Sửa -->
                                        <a asp-area="Admin" asp-controller="Author" asp-action="Edit" asp-route-id="@item.AuthorID" 
                                           class="btn btn-sm btn-light border text-primary rounded-circle" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;" title="Sửa tác giả">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>

                                        <!-- Khóa/Mở -->
                                        <form asp-area="Admin" asp-controller="Author" asp-action="ToggleActive" asp-route-id="@item.AuthorID" method="post" class="d-inline">
                                            @if (item.IsActive == true)
                                            {
                                                <button type="submit" class="btn btn-sm btn-light border text-warning rounded-circle" style="width: 32px; height: 32px; padding: 0;" title="Ẩn tác giả">
                                                    <i class="bi bi-eye-slash-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-light border text-success rounded-circle" style="width: 32px; height: 32px; padding: 0;" title="Hiển thị tác giả">
                                                    <i class="bi bi-eye-fill"></i>
                                                </button>
                                            }
                                        </form>

                                        <!-- Xóa -->
                                        <a asp-area="Admin" asp-controller="Author" asp-action="Delete" asp-route-id="@item.AuthorID" 
                                           class="btn btn-sm btn-light border text-danger rounded-circle" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;" title="Xóa tác giả">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</main>
