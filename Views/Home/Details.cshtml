@using LibraryManagement.Models
@model tblBook

@{
    ViewData["Title"] = Model.Title + " - Chi Tiết Sách";
    var author = ViewBag.Author as tblAuthor;
    var category = ViewBag.Category as tblCategory;
    var publisher = ViewBag.Publisher as tblPublisher;
    string coverImg = !string.IsNullOrEmpty(Model.Images) ? Model.Images : "/images/books/clean-code.svg";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb bg-white p-3 rounded-4 shadow-sm border" style="font-size: 13.5px;">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-primary"><i class="bi bi-house me-1"></i> Trang chủ</a></li>
        <li class="breadcrumb-item"><a href="/?categoryId=@Model.CategoryID#kho-sach" class="text-decoration-none text-secondary">@(category?.CategoryName ?? "Sách thư viện")</a></li>
        <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-white">
    <div class="card-body p-4 p-md-5">
        <div class="row g-5">
            <!-- Cột trái: Ảnh bìa & Trạng thái tồn kho -->
            <div class="col-md-4 text-center">
                <div class="p-3 bg-light rounded-4 shadow-sm border mb-3 d-inline-block">
                    <img src="@coverImg" 
                         class="img-fluid rounded-3 shadow" alt="@Model.Title" 
                         style="max-height: 400px; width: 280px; object-fit: cover;"
                         onerror="this.src='/admin/assets/img/card.jpg';">
                </div>
                
                <div class="mt-2">
                    @if (Model.AvailableQuantity > 0)
                    {
                        <div class="badge px-4 py-2 text-wrap" style="background: #dcfce7; color: #15803d; font-size: 14px; border-radius: 50px;">
                            <i class="bi bi-check-circle-fill me-1"></i> Sẵn sàng: Còn <strong>@Model.AvailableQuantity</strong> cuốn trên kệ
                        </div>
                    }
                    else
                    {
                        <div class="badge px-4 py-2 text-wrap" style="background: #fee2e2; color: #b91c1c; font-size: 14px; border-radius: 50px;">
                            <i class="bi bi-x-circle-fill me-1"></i> Tạm hết trên kệ sách
                        </div>
                    }
                </div>

                <div class="mt-3">
                    <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold w-100 shadow-sm" onclick="alert('Đã gửi yêu cầu đăng ký mượn trực tuyến cuốn sách: @Model.Title! Xin vui lòng đến quầy thư viện đọc Mã Độc Giả để nhận sách.')">
                        <i class="bi bi-journal-plus me-1"></i> Đăng Ký Mượn Sách
                    </button>
                </div>
            </div>

            <!-- Cột phải: Thông tin chi tiết -->
            <div class="col-md-8">
                <span class="badge mb-2 px-3 py-2" style="background: #eff6ff; color: #2563eb; font-size: 13px; font-weight: 600; border-radius: 50px;">
                    <i class="bi bi-tag-fill me-1"></i> @(category?.CategoryName ?? "Tài liệu học thuật")
                </span>

                <h2 class="fw-bold text-dark mb-3" style="font-size: 28px; line-height: 1.3;">@Model.Title</h2>

                <div class="d-flex flex-wrap gap-2 mb-4">
                    <span class="badge bg-light text-secondary border p-2" style="font-size: 12px;">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> Vị trí: Kệ C4 - Tầng 2
                    </span>
                    <span class="badge bg-light text-secondary border p-2" style="font-size: 12px;">
                        <i class="bi bi-shield-check text-success me-1"></i> Mã ISBN: 978-604-@(Model.BookID + 1000)
                    </span>
                    <span class="badge bg-light text-secondary border p-2" style="font-size: 12px;">
                        <i class="bi bi-calendar3 text-primary me-1"></i> Năm xuất bản: @Model.PublishYear
                    </span>
                </div>

                <div class="table-responsive mb-4">
                    <table class="table table-bordered rounded-3 overflow-hidden" style="font-size: 14px;">
                        <tbody>
                            <tr>
                                <th class="bg-light text-secondary" style="width: 30%;">Tác giả</th>
                                <td class="fw-semibold text-dark">@(author?.AuthorName ?? "Đang cập nhật")</td>
                            </tr>
                            <tr>
                                <th class="bg-light text-secondary">Nhà xuất bản</th>
                                <td>@(publisher?.PublisherName ?? "NXB Giáo Dục & Tri Thức")</td>
                            </tr>
                            <tr>
                                <th class="bg-light text-secondary">Tổng số lượng trong kho</th>
                                <td><strong>@Model.Quantity</strong> cuốn</td>
                            </tr>
                            <tr>
                                <th class="bg-light text-secondary">Số lượng khả dụng</th>
                                <td><span class="text-success fw-bold">@Model.AvailableQuantity</span> cuốn đang rảnh</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                @if (!string.IsNullOrEmpty(Model.Summary))
                {
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-file-earmark-text text-primary me-1"></i> Tóm tắt tác phẩm:</h6>
                    <div class="p-3 bg-light rounded-3 text-secondary mb-4" style="line-height: 1.6; font-size: 14px;">
                        @Model.Summary
                    </div>
                }
            </div>
        </div>

        <hr class="my-5">

        <!-- Giới thiệu chi tiết nội dung -->
        <div>
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-card-text text-primary me-2"></i> Giới thiệu chi tiết nội dung</h5>
            <div class="p-4 bg-light rounded-4 text-secondary" style="line-height: 1.7; font-size: 14.5px;">
                @if (!string.IsNullOrEmpty(Model.Contents))
                {
                    @Html.Raw(Model.Contents)
                }
                else
                {
                    <p class="mb-0">Tài liệu học tập và nghiên cứu chuẩn của nhà trường, phục vụ bạn đọc tra cứu chuyên môn.</p>
                }
            </div>
        </div>

        <div class="mt-4 pt-2">
            <a href="/" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách sách
            </a>
        </div>
    </div>
</div>
