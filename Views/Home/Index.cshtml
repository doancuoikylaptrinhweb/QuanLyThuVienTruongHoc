@using LibraryManagement.Models
@using LibraryManagement.Utilities
@model IList<tblBook>

@{
    ViewData["Title"] = "Trang Chủ - Cổng Tra Cứu Thư Viện Số";
    var authors = ViewBag.Authors as Dictionary<int, string>;
    var categories = ViewBag.Categories as List<tblCategory>;
    var catBookCounts = ViewBag.CategoryBookCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<!-- 1. HERO BANNER SECTION (Thiết kế Gradient Visual Blue chuẩn Screenshot 2) -->
<div class="hero-gradient-box mb-4">
    <div class="row align-items-center g-4">
        <!-- Cột trái: Tiêu đề, mô tả và thanh tìm kiếm lớn -->
        <div class="col-lg-7">
            <!-- Badge pill -->
            <div class="hero-badge mb-3">
                <i class="bi bi-stars"></i> Không Gian Tri Thức &amp; Sáng Tạo Mở
            </div>

            <h1 class="hero-title text-white">
                Khám Phá Hàng Nghìn Đầu Sách &amp; Giáo Trình Trực Tuyến
            </h1>

            <p class="hero-subtitle">
                Tra cứu nhanh chóng vị trí sách trên kệ, đặt mượn tiện lợi mọi lúc mọi nơi và nhận hỗ trợ tự động từ Trợ lý Thư viện AI 24/7.
            </p>

            <!-- Big Search Box -->
            <form method="get" action="/" id="heroSearchForm" class="hero-search-wrapper mb-3">
                <i class="bi bi-search text-muted me-2 fs-5"></i>
                <input type="text" name="searchString" class="form-control hero-search-input" 
                       placeholder="Nhập tên sách, tác giả, mã ISBN hoặc chuyên ngành..." 
                       value="@ViewBag.SearchString">
                <button type="submit" class="hero-search-btn">
                    Tìm Kiếm Sách
                </button>
            </form>

            <!-- Popular Quick Keywords -->
            <div class="d-flex flex-wrap align-items-center gap-2 small text-white-50">
                <span class="text-white">Tìm kiếm phổ biến:</span>
                <a href="/?searchString=Clean Code" class="quick-chip">Clean Code</a>
                <a href="/?searchString=Mắt Biếc" class="quick-chip">Mắt Biếc</a>
                <a href="/?searchString=Trí Tuệ Nhân Tạo" class="quick-chip">Trí Tuệ Nhân Tạo</a>
                <a href="/?searchString=Đắc Nhân Tâm" class="quick-chip">Đắc Nhân Tâm</a>
            </div>
        </div>

        <!-- Cột phải: Hình ảnh vòm thư viện cong và floating badge 100% Trực Tuyến -->
        <div class="col-lg-5 text-center d-none d-lg-block">
            <div class="hero-img-card">
                <img src="/admin/assets/img/hero-library.jpg" class="w-100" style="height: 255px; object-fit: cover;" alt="Thư viện hiện đại" onerror="this.src='/admin/assets/img/card.jpg';">
                
                <!-- Floating Badge 100% Trực Tuyến -->
                <div class="hero-floating-badge">
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-success" 
                         style="width: 42px; height: 42px; background: #dcfce7; font-size: 20px;">
                        <i class="bi bi-journal-check"></i>
                    </div>
                    <div class="text-start">
                        <div class="fw-bold text-dark lh-sm" style="font-size: 13.5px;">100% Trực Tuyến</div>
                        <div class="text-muted" style="font-size: 11px;">Đặt mượn &amp; gia hạn nhanh</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 2. STATS COUNTER ROW (4 Thẻ trắng chỉ số nổi bật lấy từ Database) -->
<div class="row g-3 mb-5">
    <div class="col-6 col-md-3">
        <div class="stat-card-modern">
            <div class="stat-card-number">@(ViewBag.TotalBooks ?? 0)+</div>
            <div class="stat-card-label">Đầu sách trong thư viện</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card-modern">
            <div class="stat-card-number">@(ViewBag.TotalCopies ?? 0)+</div>
            <div class="stat-card-label">Bản sách sẵn sàng phục vụ</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card-modern">
            <div class="stat-card-number">@(ViewBag.TotalReaders ?? 0)+</div>
            <div class="stat-card-label">Độc giả đăng ký hoạt động</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card-modern">
            <div class="stat-card-number">24/7</div>
            <div class="stat-card-label">Hỗ trợ AI tra cứu liên tục</div>
        </div>
    </div>
</div>

<!-- 3. DANH MỤC THỂ LOẠI SÁCH (100% TRUY VẤN TỪ DATABASE) -->
<div class="mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-3 d-flex align-items-center justify-content-center text-white shadow-sm" 
                 style="width: 44px; height: 44px; background: #4f46e5; font-size: 20px;">
                <i class="bi bi-grid-fill"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-0 text-dark" style="font-size: 22px; letter-spacing: -0.3px;">Danh Mục Thể Loại Sách</h4>
                <small class="text-muted" style="font-size: 13.5px;">Khám phá toàn bộ sách theo các chuyên ngành và lĩnh vực học thuật</small>
            </div>
        </div>
        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-2 bg-white text-primary shadow-sm border fw-semibold mt-2 mt-sm-0" 
                data-bs-toggle="modal" data-bs-target="#allCategoriesModal">
            <i class="bi bi-collection me-1"></i> Xem tất cả thể loại (@(categories?.Count ?? 0)) <i class="bi bi-arrow-right ms-1"></i>
        </button>
    </div>

    <!-- Category Cards Grid động từ CSDL -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">
        @if (categories != null && categories.Any())
        {
            string[] iconBgs = { 
                "background:#fdf2f8;color:#db2777;", 
                "background:#eff6ff;color:#2563eb;", 
                "background:#ecfdf5;color:#059669;", 
                "background:#f5f3ff;color:#7c3aed;", 
                "background:#fffbeb;color:#d97706;", 
                "background:#ecfeff;color:#0891b2;", 
                "background:#eef2ff;color:#4f46e5;", 
                "background:#f0fdf4;color:#16a34a;" 
            };
            string[] icons = { 
                "bi-book-half", 
                "bi-laptop", 
                "bi-graph-up-arrow", 
                "bi-heart-pulse", 
                "bi-mortarboard", 
                "bi-gear-wide-connected", 
                "bi-globe-americas", 
                "bi-translate" 
            };
            int idx = 0;

            foreach (var cat in categories)
            {
                string style = iconBgs[idx % iconBgs.Length];
                string iconClass = icons[idx % icons.Length];
                int count = catBookCounts.ContainsKey(cat.CategoryID) ? catBookCounts[cat.CategoryID] : 0;
                idx++;

                <div class="col">
                    <a href="/?categoryId=@cat.CategoryID#kho-sach" class="category-card-modern d-flex align-items-start gap-3 p-3 h-100 rounded-4 border bg-white shadow-sm text-decoration-none">
                        <div class="cat-icon-badge rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" 
                             style="width: 44px; height: 44px; font-size: 20px; @style">
                            <i class="bi @iconClass"></i>
                        </div>
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <h6 class="fw-bold text-dark mb-0 text-truncate" title="@cat.CategoryName" style="font-size: 14.5px;">@cat.CategoryName</h6>
                                <span class="badge rounded-pill bg-light text-secondary border ms-1" style="font-size: 11px;">@count sách</span>
                            </div>
                            <small class="text-muted d-block" style="font-size: 12px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @(string.IsNullOrWhiteSpace(cat.Description) ? "Khám phá tài liệu chuyên khảo" : cat.Description)
                            </small>
                        </div>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-4 text-muted">
                <i class="bi bi-inbox fs-2 d-block mb-1 opacity-50"></i>
                Danh mục sách đang được cập nhật.
            </div>
        }
    </div>
</div>

<!-- 4. KHO SÁCH ĐANG PHỤC VỤ (Tra cứu & Mượn sách) -->
<div id="kho-sach" class="mb-5 pt-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-dark mb-1" style="font-size: 22px;">
                <i class="bi bi-book-half text-primary me-2"></i> Kho Sách Đang Sẵn Sàng Phục Vụ
            </h4>
            <div class="text-muted small">
                Hiển thị <strong>@Model.Count</strong> đầu sách có sẵn trên kệ thư viện
            </div>
        </div>

        <!-- Filter Category Pills -->
        <div class="d-flex flex-wrap gap-2 mt-2 mt-md-0">
            <a href="/#kho-sach" class="btn btn-sm rounded-pill px-3 @(ViewBag.SelectedCategory == null ? "btn-primary" : "btn-outline-secondary bg-white text-dark")">
                Tất cả sách
            </a>
            @if (categories != null)
            {
                foreach (var cat in categories)
                {
                    <a href="/?categoryId=@cat.CategoryID#kho-sach" 
                       class="btn btn-sm rounded-pill px-3 @(ViewBag.SelectedCategory == cat.CategoryID ? "btn-primary" : "btn-outline-secondary bg-white text-dark")">
                        @cat.CategoryName
                    </a>
                }
            }
        </div>
    </div>

    <!-- Book Grid Cards -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mt-1">
        @if (Model.Count == 0)
        {
            <div class="col-12 text-center py-5 bg-white rounded-4 shadow-sm">
                <i class="bi bi-inbox text-muted" style="font-size: 3.5rem;"></i>
                <h5 class="text-dark fw-bold mt-3">Không tìm thấy cuốn sách nào phù hợp!</h5>
                <p class="text-muted small">Hãy thử tìm kiếm với từ khóa khác hoặc bấm nút bên dưới để xem toàn bộ sách.</p>
                <a href="/" class="btn btn-primary rounded-pill px-4">Xem tất cả sách</a>
            </div>
        }
        else
        {
            foreach (var item in Model)
            {
                string detailUrl = Functions.TitlesSlugGeneration("/sach", item.Title, item.BookID);
                string authorName = authors != null && authors.ContainsKey(item.AuthorID) ? authors[item.AuthorID] : "Đang cập nhật";
                string coverImg = !string.IsNullOrEmpty(item.Images) ? item.Images : "/images/books/clean-code.svg";

                <div class="col">
                    <div class="book-card-pro">
                        <!-- Book Cover Image -->
                        <div class="book-img-wrap">
                            <a href="@detailUrl">
                                <img src="@coverImg" alt="@item.Title" onerror="this.src='/admin/assets/img/card.jpg';">
                            </a>
                            <!-- Badge Mã sách (Top-left) -->
                            <div class="position-absolute top-0 start-0 m-2">
                                <span class="badge" style="background: rgba(37, 99, 235, 0.92); backdrop-filter: blur(4px); font-size: 11px; font-weight: 700; letter-spacing: 0.3px;">
                                    @item.Code
                                </span>
                            </div>
                            <!-- Badge số lượng tồn (Top-right) -->
                            <div class="position-absolute top-0 end-0 m-2">
                                @if (item.AvailableQuantity > 0)
                                {
                                    <span class="badge" style="background: rgba(22, 163, 74, 0.9); backdrop-filter: blur(4px); font-size: 11px;">
                                        Còn @item.AvailableQuantity cuốn
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger" style="font-size: 11px;">
                                        Đã hết sách
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Card Body Content -->
                        <div class="card-body p-3 d-flex flex-column flex-grow-1">
                            <h6 class="fw-bold mb-1" style="font-size: 14.5px; line-height: 1.35;">
                                <a href="@detailUrl" class="text-decoration-none text-dark hover-primary">
                                    @item.Title
                                </a>
                            </h6>

                            <div class="text-muted small mb-2 d-flex align-items-center gap-1" style="font-size: 12px;">
                                <i class="bi bi-person text-primary"></i> @authorName
                            </div>

                            <p class="text-secondary small mb-3 flex-grow-1" style="font-size: 12.5px; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @(string.IsNullOrEmpty(item.Summary) ? "Tài liệu học tập và tham khảo chính thức của thư viện trường học." : item.Summary)
                            </p>

                            <!-- Bottom Action -->
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="badge bg-light text-secondary border small" style="font-size: 10.5px;">
                                    Năm @item.PublishYear
                                </span>
                                <a href="@detailUrl" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-semibold" style="font-size: 12.5px;">
                                    Chi tiết <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- MODAL: XEM TẤT CẢ THỂ LOẠI SÁCH -->
<div class="modal fade" id="allCategoriesModal" tabindex="-1" aria-labelledby="allCategoriesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white pb-3" style="background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-collection-fill fs-4"></i>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="allCategoriesModalLabel">Tất Cả Thể Loại Sách Thư Viện</h5>
                        <small class="text-white-50" style="font-size: 12.5px;">Tổng hợp @(categories?.Count ?? 0) danh mục chủ đề chuyên môn phục vụ bạn đọc</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4 bg-light">
                <!-- Ô tìm kiếm nhanh thể loại bên trong Modal -->
                <div class="input-group mb-4 shadow-sm rounded-pill overflow-hidden bg-white border">
                    <span class="input-group-text bg-transparent border-0 text-muted ps-3"><i class="bi bi-search"></i></span>
                    <input type="text" id="catFilterInput" class="form-control border-0 bg-transparent py-2" 
                           placeholder="Nhập tên thể loại hoặc chủ đề cần tìm..." onkeyup="filterCategoriesModal()">
                    <span class="input-group-text bg-transparent border-0 text-muted pe-3 small" id="catFilterCount">@(categories?.Count ?? 0) thể loại</span>
                </div>

                <div class="row row-cols-1 row-cols-md-2 g-3" id="catModalList">
                    @if (categories != null && categories.Any())
                    {
                        string[] mIconBgs = { 
                            "background:#fdf2f8;color:#db2777;", 
                            "background:#eff6ff;color:#2563eb;", 
                            "background:#ecfdf5;color:#059669;", 
                            "background:#f5f3ff;color:#7c3aed;", 
                            "background:#fffbeb;color:#d97706;", 
                            "background:#ecfeff;color:#0891b2;", 
                            "background:#eef2ff;color:#4f46e5;", 
                            "background:#f0fdf4;color:#16a34a;" 
                        };
                        string[] mIcons = { 
                            "bi-book-half", 
                            "bi-laptop", 
                            "bi-graph-up-arrow", 
                            "bi-heart-pulse", 
                            "bi-mortarboard", 
                            "bi-gear-wide-connected", 
                            "bi-globe-americas", 
                            "bi-translate" 
                        };
                        int mIdx = 0;

                        foreach (var cat in categories)
                        {
                            string style = mIconBgs[mIdx % mIconBgs.Length];
                            string iconClass = mIcons[mIdx % mIcons.Length];
                            int count = catBookCounts.ContainsKey(cat.CategoryID) ? catBookCounts[cat.CategoryID] : 0;
                            mIdx++;

                            <div class="col cat-modal-item" data-name="@cat.CategoryName.ToLower()" data-desc="@((cat.Description ?? "").ToLower())">
                                <div class="card h-100 border-0 rounded-4 shadow-sm p-3 bg-white">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" 
                                             style="width: 48px; height: 48px; font-size: 22px; @style">
                                            <i class="bi @iconClass"></i>
                                        </div>
                                        <div class="flex-grow-1 overflow-hidden">
                                            <div class="d-flex align-items-center justify-content-between mb-1">
                                                <h6 class="fw-bold text-dark mb-0 text-truncate" title="@cat.CategoryName">@cat.CategoryName</h6>
                                                <span class="badge rounded-pill bg-light text-secondary border small" style="font-size: 11px;">@count đầu sách</span>
                                            </div>
                                            <p class="text-muted small mb-3" style="font-size: 12px; line-height: 1.45; min-height: 34px;">
                                                @(string.IsNullOrWhiteSpace(cat.Description) ? "Khám phá các tài liệu chuyên khảo thuộc thể loại này." : cat.Description)
                                            </p>
                                            <a href="/?categoryId=@cat.CategoryID#kho-sach" class="btn btn-outline-primary btn-sm rounded-pill w-100 fw-semibold" style="font-size: 12.5px;" onclick="closeCategoryModal()">
                                                <i class="bi bi-book me-1"></i> Xem sách thể loại này
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="modal-footer bg-white border-top p-3 justify-content-between">
                <a href="/?categoryId=0#kho-sach" class="btn btn-outline-secondary rounded-pill px-4 btn-sm fw-semibold" onclick="closeCategoryModal()">
                    <i class="bi bi-grid-fill me-1"></i> Xem toàn bộ kho sách
                </a>
                <button type="button" class="btn btn-primary rounded-pill px-4 btn-sm fw-semibold" data-bs-dismiss="modal">
                    Đóng
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function filterCategoriesModal() {
        var input = document.getElementById("catFilterInput").value.toLowerCase().trim();
        var items = document.querySelectorAll(".cat-modal-item");
        var visibleCount = 0;

        items.forEach(function(item) {
            var name = item.getAttribute("data-name") || "";
            var desc = item.getAttribute("data-desc") || "";
            if (name.includes(input) || desc.includes(input)) {
                item.style.display = "";
                visibleCount++;
            } else {
                item.style.display = "none";
            }
        });

        var countBadge = document.getElementById("catFilterCount");
        if (countBadge) {
            countBadge.textContent = visibleCount + " thể loại";
        }
    }

    function closeCategoryModal() {
        var modalEl = document.getElementById('allCategoriesModal');
        if (modalEl) {
            var modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
        }
    }
</script>
