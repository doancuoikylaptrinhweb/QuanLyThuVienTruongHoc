@using LibraryManagement.Utilities
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Thư Viện Số - Trường Học Thông Minh")</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap & Icons -->
    <link href="/admin/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="/admin/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Custom Modern Library CSS -->
    <link href="/css/modern-library.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
            background-color: #f8fafc;
            color: #1e293b;
        }
    </style>
</head>

<body>

    <!-- 1. Top Announcement Bar (Header tím than đậm cho cổng bạn đọc) -->
    <div class="top-notice-bar">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3 gap-md-4 small">
                <span><i class="bi bi-clock me-1 text-primary"></i> Giờ mở cửa: 07:30 - 21:00 (T2 - T7)</span>
                <span><i class="bi bi-telephone me-1 text-primary"></i> Hotline: (024) 3822-0801</span>
            </div>
            <div class="d-none d-md-block small">
                <span><i class="bi bi-geo-alt me-1 text-primary"></i> Tòa nhà Trung Tâm Thông tin &amp; Thư viện</span>
            </div>
        </div>
    </div>

    <!-- 2. Main Client Navbar Dành Riêng Cho Khách & Độc Giả -->
    <nav class="navbar navbar-expand-lg client-navbar sticky-top">
        <div class="container">
            <!-- Brand Logo Cổng Độc Giả -->
            <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none me-3" href="/">
                <div class="brand-badge-icon">
                    <i class="bi bi-book-half"></i>
                </div>
                <div>
                    <div class="brand-title">THƯ VIỆN SỐ</div>
                    <div class="brand-sub">TRƯỜNG HỌC THÔNG MINH</div>
                </div>
            </a>

            <!-- Mobile Toggler -->
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#clientNavbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navbar Links & Search -->
            <div class="collapse navbar-collapse" id="clientNavbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                    <li class="nav-item">
                        <a class="nav-link nav-link-modern active" href="/">
                            <i class="bi bi-house"></i> Trang chủ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-modern" href="#kho-sach">
                            <i class="bi bi-search"></i> Tra cứu sách
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-modern" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#noiQuyModal">
                            <i class="bi bi-journal-text"></i> Nội quy mượn trả
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-modern" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#gioiThieuModal">
                            <i class="bi bi-info-circle"></i> Giới thiệu
                        </a>
                    </li>
                </ul>

                <!-- Navbar Quick Search -->
                <form method="get" action="/" class="d-flex position-relative me-3 my-2 my-lg-0">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" name="searchString" class="nav-search-input" placeholder="Tìm tên sách, ISBN..." value="@ViewBag.SearchString">
                </form>

                <!-- Khu vực điều khiển người dùng (Tách riêng khách vãng lai & Admin) -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    @if (!Functions.IsLogin())
                    {
                        <!-- TRẠNG THÁI KHÁCH TRUY CẬP (GUEST): HOÀN TOÀN KHÔNG HIỆN THÔNG TIN ADMIN -->
                        <button type="button" class="btn-ticket-pill" data-bs-toggle="modal" data-bs-target="#myTicketsModal">
                            <i class="bi bi-card-checklist text-primary"></i> Tra cứu phiếu mượn
                        </button>
                        
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold d-flex align-items-center gap-1 shadow-sm" onclick="openAuthModal('login')">
                                <i class="bi bi-box-arrow-in-right"></i> Đăng Nhập
                            </button>
                            <button type="button" class="btn btn-primary rounded-pill px-3 py-2 fw-semibold d-flex align-items-center gap-1 shadow-sm" onclick="openAuthModal('register')">
                                <i class="bi bi-person-plus"></i> Đăng Ký
                            </button>
                        </div>
                    }
                    else if (Functions._Role == "Reader")
                    {
                        <!-- TRẠNG THÁI ĐỘC GIẢ / BẠN ĐỌC ĐÃ ĐĂNG NHẬP (KHÔNG HIỆN ADMIN) -->
                        <a href="/BorrowRequest/MyRequests" class="btn-ticket-pill text-decoration-none">
                            <i class="bi bi-card-checklist text-primary"></i> Phiếu mượn của tôi
                        </a>

                        <div class="dropdown">
                            <a class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle ps-1" href="#" data-bs-toggle="dropdown">
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="width: 36px; height: 36px; background: #059669; font-size: 14px;">
                                    @(Functions._UserName.Length > 0 ? Functions._UserName.Substring(0, 1).ToUpper() : "U")
                                </div>
                                <span class="d-none d-xl-inline fw-semibold text-dark small">
                                    @Functions._UserName
                                </span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" style="font-size: 13.5px;">
                                <li class="dropdown-header text-start">
                                    <h6 class="mb-0 fw-bold text-dark">@Functions._UserName</h6>
                                    <small class="text-muted">Tài khoản Bạn đọc</small>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" href="/BorrowRequest/MyRequests">
                                        <i class="bi bi-clock-history text-primary"></i> Lịch sử &amp; Yêu cầu mượn
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#myTicketsModal">
                                        <i class="bi bi-journal-check text-success"></i> Tra cứu phiếu mượn cá nhân
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2 text-danger" href="/Home/Logout">
                                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else if (Functions.IsAdmin())
                    {
                        <!-- QUẢN TRỊ VIÊN ĐÃ ĐĂNG NHẬP -->
                        <div class="dropdown">
                            <a class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle ps-1" href="#" data-bs-toggle="dropdown">
                                <div class="purple-avatar">N</div>
                                <span class="d-none d-xl-inline fw-semibold text-dark small">
                                    @Functions._UserName
                                </span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" style="font-size: 13.5px;">
                                <li class="dropdown-header text-start">
                                    <h6 class="mb-0 fw-bold">@Functions._UserName</h6>
                                    <small class="text-muted">Quản trị viên / Thủ thư</small>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2 text-primary fw-semibold" href="/Admin">
                                        <i class="bi bi-speedometer2"></i> Vào Bảng Điều Khiển Admin
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2 text-danger" href="/Home/Logout">
                                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                </div>

            </div>
        </div>
    </nav>

    <!-- Main Body Container -->
    <div class="container my-4">
        @RenderBody()
    </div>

    <!-- Footer Dành Riêng Cho Độc Giả (Không lộ đường dẫn quản trị cho khách) -->
    <footer class="bg-white border-top py-5 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="brand-badge-icon" style="width: 36px; height: 36px; font-size: 18px;">
                            <i class="bi bi-book-half"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark fs-6">THƯ VIỆN SỐ</div>
                            <div class="text-muted small" style="font-size: 10px; letter-spacing: 0.5px;">TRƯỜNG HỌC THÔNG MINH</div>
                        </div>
                    </div>
                    <p class="text-muted small mb-3" style="line-height: 1.6;">
                        Hệ thống thư viện điện tử kết hợp trợ lý AI thông minh, hỗ trợ bạn đọc tra cứu kho tài liệu số, vị trí kệ sách và hướng dẫn mượn trả trực tuyến 24/7.
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Cổng Bạn Đọc</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Tra Cứu Kệ Sách</span>
                        <span class="badge bg-info-subtle text-info border border-info-subtle">Trợ Lý AI 24/7</span>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-4">
                    <h6 class="fw-bold text-dark mb-3">Thông Tin Liên Hệ</h6>
                    <ul class="list-unstyled text-muted small d-flex flex-column gap-2 mb-0">
                        <li><i class="bi bi-geo-alt text-primary me-2"></i> Tòa nhà Trung Tâm Thông tin &amp; Thư viện</li>
                        <li><i class="bi bi-clock text-primary me-2"></i> Mở cửa: 07:30 - 21:00 (Thứ 2 đến Thứ 7)</li>
                        <li><i class="bi bi-telephone text-primary me-2"></i> Hotline: (024) 3822-0801</li>
                        <li><i class="bi bi-envelope text-primary me-2"></i> Email: thuvien@truonghoc.edu.vn</li>
                    </ul>
                </div>

                <div class="col-sm-6 col-lg-4">
                    <h6 class="fw-bold text-dark mb-3">Dành Cho Bạn Đọc</h6>
                    <ul class="list-unstyled text-muted small d-flex flex-column gap-2 mb-0">
                        <li><a href="/" class="text-decoration-none text-muted"><i class="bi bi-chevron-right me-1 text-primary"></i> Trang chủ cổng thư viện</a></li>
                        <li><a href="#kho-sach" class="text-decoration-none text-muted"><i class="bi bi-chevron-right me-1 text-primary"></i> Tra cứu danh mục kho sách</a></li>
                        <li><a href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#noiQuyModal" class="text-decoration-none text-muted"><i class="bi bi-chevron-right me-1 text-primary"></i> Nội quy mượn trả tài liệu</a></li>
                        <li><a href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#myTicketsModal" class="text-decoration-none text-muted"><i class="bi bi-chevron-right me-1 text-primary"></i> Tra cứu phiếu mượn cá nhân</a></li>
                    </ul>
                </div>
            </div>

            <hr class="my-4 text-muted opacity-25">

            <div class="d-flex flex-wrap justify-content-between align-items-center small text-muted">
                <div>&copy; 2026 <strong>Thư Viện Số - Trường Học Thông Minh</strong>. Cổng thông tin phục vụ bạn đọc &amp; sinh viên.</div>
                <div>Giao diện trực quan hiện đại Visual Blue Theme.</div>
            </div>
        </div>
    </footer>

    <!-- MODAL 1: NỘI QUY MƯỢN TRẢ -->
    <div class="modal fade" id="noiQuyModal" tabindex="-1" aria-labelledby="noiQuyModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title fw-bold" id="noiQuyModalLabel"><i class="bi bi-journal-text me-2"></i> Nội Quy Mượn Trả Sách</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item d-flex gap-2 align-items-start px-0">
                            <i class="bi bi-check-circle-fill text-success fs-6 mt-1"></i>
                            <div><strong>Đối tượng mượn:</strong> Toàn thể sinh viên, học viên và giảng viên có thẻ thư viện còn hiệu lực.</div>
                        </li>
                        <li class="list-group-item d-flex gap-2 align-items-start px-0">
                            <i class="bi bi-check-circle-fill text-success fs-6 mt-1"></i>
                            <div><strong>Thời hạn mượn:</strong> Tối đa <strong>14 ngày</strong> cho mỗi lần mượn, có thể gia hạn trực tuyến 1 lần (thêm 7 ngày).</div>
                        </li>
                        <li class="list-group-item d-flex gap-2 align-items-start px-0">
                            <i class="bi bi-check-circle-fill text-success fs-6 mt-1"></i>
                            <div><strong>Số lượng tài liệu:</strong> Mỗi bạn đọc được mượn tối đa <strong>3 cuốn sách</strong> cùng một thời điểm.</div>
                        </li>
                        <li class="list-group-item d-flex gap-2 align-items-start px-0">
                            <i class="bi bi-exclamation-triangle-fill text-warning fs-6 mt-1"></i>
                            <div><strong>Quy định bảo quản:</strong> Giữ gìn sách cẩn thận, không làm rách, viết vẽ bẩn hoặc đánh dấu mực lên tài liệu.</div>
                        </li>
                    </ul>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-dismiss="modal">Đã hiểu</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL 2: GIỚI THIỆU -->
    <div class="modal fade" id="gioiThieuModal" tabindex="-1" aria-labelledby="gioiThieuModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title fw-bold" id="gioiThieuModalLabel"><i class="bi bi-info-circle me-2"></i> Giới Thiệu Thư Viện Số</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 small">
                    <p>Chào mừng bạn đến với <strong>Thư Viện Số - Trường Học Thông Minh</strong>! Đây là không gian tri thức mở được số hóa toàn diện giúp bạn đọc:</p>
                    <div class="d-flex flex-column gap-2 my-3">
                        <div class="p-2 rounded-3 bg-light border d-flex align-items-center gap-2">
                            <i class="bi bi-search text-primary fs-5"></i>
                            <span>Tra cứu nhanh hàng ngàn đầu sách giáo trình, công nghệ và văn học.</span>
                        </div>
                        <div class="p-2 rounded-3 bg-light border d-flex align-items-center gap-2">
                            <i class="bi bi-robot text-primary fs-5"></i>
                            <span>Trợ lý AI 24/7 giải đáp thắc mắc và gợi ý sách theo đúng chuyên ngành.</span>
                        </div>
                        <div class="p-2 rounded-3 bg-light border d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt text-primary fs-5"></i>
                            <span>Hiển thị chính xác vị trí tầng, kệ và ngăn sách trong kho thực tế.</span>
                        </div>
                    </div>
                    <div class="text-muted">Cổng phục vụ trực tuyến 24/7 dành cho sinh viên và bạn đọc.</div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL 3: TRA CỨU PHIẾU MƯỢN / PHIẾU TRẢ CỦA TÔI -->
    <div class="modal fade" id="myTicketsModal" tabindex="-1" aria-labelledby="myTicketsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title fw-bold" id="myTicketsModalLabel"><i class="bi bi-card-checklist me-2"></i> Tra Cứu Phiếu Mượn &amp; Trả Sách</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Quick Search for Guests / Readers -->
                    <div class="p-3 bg-light rounded-4 border mb-4">
                        <label class="form-label fw-semibold small text-dark mb-1">Tra cứu nhanh bằng Mã phiếu mượn (PM...), Mã trả sách (PT...) hoặc Mã bạn đọc (DG...):</label>
                        <div class="d-flex gap-2">
                            <input type="text" id="ticketSearchInput" class="form-control" placeholder="Ví dụ: PM0001, PT0001, DG0001, an.nguyen..." onkeypress="if(event.key === 'Enter') searchTicketAction()">
                            <button type="button" id="btnTicketSearch" class="btn btn-primary px-4 fw-semibold" onclick="searchTicketAction()">
                                <i class="bi bi-search me-1"></i> Tra cứu
                            </button>
                        </div>
                        <div id="ticketSearchAlert" class="alert alert-danger d-none mt-2 mb-0 py-2 px-3 small rounded-3"></div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="font-size: 13.5px;">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã phiếu</th>
                                    <th>Mã trả</th>
                                    <th>Tên sách</th>
                                    <th>Bạn đọc</th>
                                    <th>Ngày mượn</th>
                                    <th>Hạn trả</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody id="ticketResultBody">
                                <tr>
                                    <td><span class="badge" style="background: #eef2ff; color: #4338ca; font-weight: 700;">PM0001</span></td>
                                    <td><span class="text-muted small">---</span></td>
                                    <td><strong>Harry Potter và Hòn Đá Phù Thủy</strong></td>
                                    <td><span class="badge bg-light text-dark border me-1">DG0001</span> Nguyễn Văn An</td>
                                    <td>07/11/2026</td>
                                    <td>21/11/2026</td>
                                    <td><span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3">Đang mượn</span></td>
                                </tr>
                                <tr>
                                    <td><span class="badge" style="background: #eef2ff; color: #4338ca; font-weight: 700;">PM0002</span></td>
                                    <td><span class="badge" style="background: #ecfdf5; color: #059669; font-weight: 700;">PT0002</span></td>
                                    <td><strong>Clean Code - Mã Sạch Thực Chiến</strong></td>
                                    <td><span class="badge bg-light text-dark border me-1">DG0002</span> Trần Thị Bình</td>
                                    <td>15/10/2026</td>
                                    <td>29/10/2026</td>
                                    <td><span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">Đã trả</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL 4: ĐĂNG NHẬP & ĐĂNG KÝ CHO BẠN ĐỌC -->
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-primary text-white pb-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock-fill fs-4"></i>
                        <h5 class="modal-title fw-bold mb-0" id="loginModalLabel">Cổng Xác Thực Bạn Đọc</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                <div class="modal-body p-4">
                    <!-- Nav Tabs Chọn Đăng Nhập hoặc Đăng Ký -->
                    <ul class="nav nav-pills nav-fill p-1 bg-light rounded-pill mb-4" id="authTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active rounded-pill fw-semibold py-2" id="tab-login-btn" data-bs-toggle="pill" data-bs-target="#tab-login" type="button" role="tab" aria-selected="true">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link rounded-pill fw-semibold py-2" id="tab-register-btn" data-bs-toggle="pill" data-bs-target="#tab-register" type="button" role="tab" aria-selected="false">
                                <i class="bi bi-person-plus me-1"></i> Đăng Ký Mới
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="authTabContent">
                        <!-- TAB 1: ĐĂNG NHẬP -->
                        <div class="tab-pane fade show active" id="tab-login" role="tabpanel">
                            <div id="loginAlert" class="alert alert-danger d-none rounded-3 py-2 px-3 small"></div>
                            
                            <form id="clientLoginForm" onsubmit="handleClientLogin(event)">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Tên đăng nhập / Mã bạn đọc <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                        <input type="text" id="clientLoginUser" class="form-control border-start-0 ps-0" required placeholder="Ví dụ: docgia01, an.nguyen...">
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Mật khẩu <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-key"></i></span>
                                        <input type="password" id="clientLoginPass" class="form-control border-start-0 ps-0" required placeholder="Nhập mật khẩu...">
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-3 small">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="rememberMe">
                                        <label class="form-check-label text-muted" for="rememberMe">Ghi nhớ đăng nhập</label>
                                    </div>
                                    <a href="javascript:void(0)" onclick="alert('Vui lòng liên hệ quầy Thủ thư để được hỗ trợ cấp lại mật khẩu thẻ thư viện!')" class="text-decoration-none">Quên mật khẩu?</a>
                                </div>
                                <button type="submit" id="clientLoginBtn" class="btn btn-primary w-100 rounded-pill py-2 fw-semibold shadow-sm">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
                                </button>
                            </form>

                            <div class="text-center mt-3 small text-muted">
                                Chưa có tài khoản bạn đọc? 
                                <a href="javascript:void(0)" onclick="switchAuthTab('register')" class="text-primary fw-semibold text-decoration-none ms-1">Đăng ký ngay</a>
                            </div>
                        </div>

                        <!-- TAB 2: ĐĂNG KÝ -->
                        <div class="tab-pane fade" id="tab-register" role="tabpanel">
                            <div id="registerAlert" class="alert d-none rounded-3 py-2 px-3 small"></div>

                            <form id="clientRegisterForm" onsubmit="handleClientRegister(event)">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Họ và tên <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-card-text"></i></span>
                                        <input type="text" id="regFullName" class="form-control border-start-0 ps-0" required placeholder="Ví dụ: Nguyễn Văn An">
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Tên đăng nhập <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person-badge"></i></span>
                                        <input type="text" id="regUserName" class="form-control border-start-0 ps-0" required placeholder="Tối thiểu 3 ký tự (ví dụ: annguyen)">
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Email (tùy chọn)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                        <input type="email" id="regEmail" class="form-control border-start-0 ps-0" placeholder="an.nguyen@sinhvien.edu.vn">
                                    </div>
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-sm-6">
                                        <label class="form-label fw-semibold small">Mật khẩu <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                            <input type="password" id="regPassword" class="form-control border-start-0 ps-0" required placeholder="Tối thiểu 6 ký tự">
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="form-label fw-semibold small">Nhập lại mật khẩu <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-check2-circle"></i></span>
                                            <input type="password" id="regConfirmPassword" class="form-control border-start-0 ps-0" required placeholder="Xác nhận lại">
                                        </div>
                                    </div>
                                </div>

                                <button type="submit" id="clientRegisterBtn" class="btn btn-success w-100 rounded-pill py-2 fw-semibold shadow-sm">
                                    <i class="bi bi-person-check me-1"></i> Hoàn Tất Đăng Ký
                                </button>
                            </form>

                            <div class="text-center mt-3 small text-muted">
                                Đã có tài khoản bạn đọc? 
                                <a href="javascript:void(0)" onclick="switchAuthTab('login')" class="text-primary fw-semibold text-decoration-none ms-1">Đăng nhập ngay</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 bg-light p-3 text-center d-block">
                    <span class="text-muted small">Cần hỗ trợ làm thẻ thư viện vật lý?</span>
                    <a href="javascript:void(0)" onclick="alert('Bạn đọc đến trực tiếp Quầy Thủ thư tại Tầng 1 - Tòa nhà Trung Tâm để nhận thẻ thư viện và mượn giáo trình!')" class="text-decoration-none fw-semibold ms-1">Hướng dẫn quầy thủ thư</a>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. CHATBOT AI FLOATING WIDGET (Trợ lý Thư viện AI 24/7) -->
    <button id="modern-chatbot-btn" onclick="toggleModernChat()" title="Trợ lý Thư viện AI 24/7">
        <i class="bi bi-robot"></i>
    </button>

    <div id="modern-chat-window">
        <div class="chat-window-header">
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="bi bi-robot fs-5"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold text-white" style="font-size: 14.5px;">Trợ Lý AI Thư Viện</h6>
                    <small style="font-size: 11px; opacity: 0.85;">Trực tuyến 24/7 • Hỗ trợ tìm sách</small>
                </div>
            </div>
            <button class="btn btn-sm text-white p-0 border-0 fs-5" onclick="toggleModernChat()"><i class="bi bi-x-lg"></i></button>
        </div>

        <div class="chat-window-body" id="modernChatMessages">
            <div class="chat-bubble chat-bot-bubble">
                👋 Xin chào! Tôi là <strong>Trợ lý Ảo AI Thư viện</strong>. Bạn cần tìm sách gì, hướng dẫn thủ tục hay vị trí sách trên kệ nào hôm nay?
            </div>
        </div>

        <!-- Quick Suggestions -->
        <div class="px-3 py-2 bg-white border-top d-flex gap-1 overflow-auto" style="white-space: nowrap;">
            <button class="btn btn-outline-primary btn-sm py-0 rounded-pill" style="font-size: 12px;" onclick="sendModernQuick('Gợi ý sách hay')">Gợi ý sách</button>
            <button class="btn btn-outline-primary btn-sm py-0 rounded-pill" style="font-size: 12px;" onclick="sendModernQuick('Quy định mượn sách')">Quy định mượn</button>
            <button class="btn btn-outline-primary btn-sm py-0 rounded-pill" style="font-size: 12px;" onclick="sendModernQuick('Tìm sách Clean Code')">Clean Code</button>
        </div>

        <div class="p-2 bg-white border-top d-flex gap-2">
            <input type="text" id="modernChatInput" class="form-control form-control-sm rounded-pill px-3" placeholder="Nhập câu hỏi của bạn..." onkeypress="handleModernKey(event)">
            <button class="btn btn-primary btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; flex-shrink: 0;" onclick="sendModernMessage()">
                <i class="bi bi-send-fill" style="font-size: 13px;"></i>
            </button>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/admin/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <script>
        function toggleModernChat() {
            var chat = document.getElementById("modern-chat-window");
            chat.style.display = (chat.style.display === "flex") ? "none" : "flex";
            if (chat.style.display === "flex") {
                document.getElementById("modernChatInput").focus();
            }
        }

        function handleModernKey(e) {
            if (e.key === "Enter") sendModernMessage();
        }

        function sendModernQuick(text) {
            document.getElementById("modernChatInput").value = text;
            sendModernMessage();
        }

        function sendModernMessage() {
            var input = document.getElementById("modernChatInput");
            var message = input.value.trim();
            if (!message) return;

            var container = document.getElementById("modernChatMessages");
            container.innerHTML += '<div class="chat-bubble chat-user-bubble">' + message + '</div>';
            input.value = "";
            container.scrollTop = container.scrollHeight;

            var formData = new FormData();
            formData.append("message", message);

            fetch('/Home/ChatBot', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                container.innerHTML += '<div class="chat-bubble chat-bot-bubble">' + data.reply + '</div>';
                container.scrollTop = container.scrollHeight;
            })
            .catch(err => {
                container.innerHTML += '<div class="chat-bubble chat-bot-bubble text-danger">Có lỗi kết nối, vui lòng thử lại!</div>';
                container.scrollTop = container.scrollHeight;
            });
        }

        // Mở Modal Xác Thực (Đăng Nhập hoặc Đăng Ký)
        function openAuthModal(mode) {
            var modalEl = document.getElementById('loginModal');
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
            switchAuthTab(mode);
        }

        // Chuyển đổi qua lại giữa tab Đăng Nhập và Đăng Ký
        function switchAuthTab(tab) {
            if (tab === 'register') {
                var regBtn = document.getElementById('tab-register-btn');
                if (regBtn) {
                    var trigger = new bootstrap.Tab(regBtn);
                    trigger.show();
                }
            } else {
                var loginBtn = document.getElementById('tab-login-btn');
                if (loginBtn) {
                    var trigger = new bootstrap.Tab(loginBtn);
                    trigger.show();
                }
            }
        }

        // Xử lý đăng ký tài khoản từ trang chủ khách
        function handleClientRegister(e) {
            e.preventDefault();
            var fullName = document.getElementById("regFullName").value.trim();
            var userName = document.getElementById("regUserName").value.trim();
            var email = document.getElementById("regEmail").value.trim();
            var password = document.getElementById("regPassword").value;
            var confirmPassword = document.getElementById("regConfirmPassword").value;
            var alertBox = document.getElementById("registerAlert");
            var btn = document.getElementById("clientRegisterBtn");

            alertBox.className = "alert alert-danger d-none rounded-3 py-2 px-3 small";

            if (password !== confirmPassword) {
                alertBox.textContent = "Mật khẩu xác nhận không khớp!";
                alertBox.classList.remove("d-none");
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang tạo tài khoản...';

            var formData = new FormData();
            formData.append("fullName", fullName);
            formData.append("userName", userName);
            formData.append("email", email);
            formData.append("password", password);
            formData.append("confirmPassword", confirmPassword);

            fetch('/Home/Register', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alertBox.className = "alert alert-success rounded-3 py-2 px-3 small";
                    alertBox.textContent = data.message || "Đăng ký thành công! Đang chuyển hướng...";
                    alertBox.classList.remove("d-none");
                    setTimeout(() => {
                        window.location.href = data.redirectUrl || '/';
                    }, 1200);
                } else {
                    alertBox.className = "alert alert-danger rounded-3 py-2 px-3 small";
                    alertBox.textContent = data.message || "Đăng ký thất bại, vui lòng thử lại!";
                    alertBox.classList.remove("d-none");
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-person-check me-1"></i> Hoàn Tất Đăng Ký';
                }
            })
            .catch(err => {
                alertBox.className = "alert alert-danger rounded-3 py-2 px-3 small";
                alertBox.textContent = "Có lỗi kết nối, vui lòng thử lại!";
                alertBox.classList.remove("d-none");
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-person-check me-1"></i> Hoàn Tất Đăng Ký';
            });
        }

        // Xử lý đăng nhập từ trang chủ khách
        function handleClientLogin(e) {
            e.preventDefault();
            var user = document.getElementById("clientLoginUser").value.trim();
            var pass = document.getElementById("clientLoginPass").value.trim();
            var alertBox = document.getElementById("loginAlert");
            var btn = document.getElementById("clientLoginBtn");

            alertBox.classList.add("d-none");
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang xử lý...';

            var formData = new FormData();
            formData.append("userName", user);
            formData.append("password", pass);

            fetch('/Home/Login', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    window.location.href = data.redirectUrl || '/';
                } else {
                    alertBox.textContent = data.message || "Tên đăng nhập hoặc mật khẩu không chính xác!";
                    alertBox.classList.remove("d-none");
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập';
                }
            })
            .catch(err => {
                alertBox.textContent = "Có lỗi kết nối, vui lòng thử lại!";
                alertBox.classList.remove("d-none");
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập';
            });
        }

        // Xử lý tra cứu phiếu mượn & trả sách qua API
        function searchTicketAction() {
            var input = document.getElementById("ticketSearchInput");
            var code = input.value.trim();
            var alertBox = document.getElementById("ticketSearchAlert");
            var tbody = document.getElementById("ticketResultBody");
            var btn = document.getElementById("btnTicketSearch");

            alertBox.classList.add("d-none");

            if (!code) {
                alertBox.textContent = "Vui lòng nhập Mã phiếu mượn (PM...), Mã trả (PT...) hoặc Mã bạn đọc (DG...)!";
                alertBox.classList.remove("d-none");
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang tra...';

            fetch('/Home/SearchTicket?keyword=' + encodeURIComponent(code))
            .then(res => res.json())
            .then(data => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-search me-1"></i> Tra cứu';

                if (data.success && data.data && data.data.length > 0) {
                    var html = "";
                    data.data.forEach(item => {
                        var returnBadge = item.status === "Đã trả" 
                            ? '<span class="badge" style="background: #ecfdf5; color: #059669; font-weight: 700;">' + item.returnCode + '</span>'
                            : '<span class="text-muted small">---</span>';

                        var statusBadge = item.status === "Đã trả"
                            ? '<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">Đã trả</span>'
                            : '<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3">Đang mượn</span>';

                        html += '<tr>' +
                            '<td><span class="badge" style="background: #eef2ff; color: #4338ca; font-weight: 700;">' + item.ticketCode + '</span></td>' +
                            '<td>' + returnBadge + '</td>' +
                            '<td><strong>' + item.bookTitle + '</strong></td>' +
                            '<td><span class="badge bg-light text-dark border me-1">' + item.userCode + '</span> ' + item.userName + '</td>' +
                            '<td>' + item.borrowDate + '</td>' +
                            '<td>' + item.dueDate + '</td>' +
                            '<td>' + statusBadge + '</td>' +
                        '</tr>';
                    });
                    tbody.innerHTML = html;
                } else {
                    alertBox.textContent = data.message || "Không tìm thấy dữ liệu phù hợp!";
                    alertBox.classList.remove("d-none");
                }
            })
            .catch(err => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-search me-1"></i> Tra cứu';
                alertBox.textContent = "Có lỗi kết nối máy chủ, vui lòng thử lại!";
                alertBox.classList.remove("d-none");
            });
        }
    </script>

</body>
</html>
