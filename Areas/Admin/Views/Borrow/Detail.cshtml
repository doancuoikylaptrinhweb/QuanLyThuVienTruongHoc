@using LibraryManagement.Models
@model tblBorrowTicket

@{
    ViewData["Title"] = $"Chi Tiết Phiếu Mượn [{Model.Code}]";
    var user = ViewBag.User as tblUser;
    var details = ViewBag.Details as List<tblBorrowDetail> ?? new List<tblBorrowDetail>();
    var books = ViewBag.Books as Dictionary<long, tblBook> ?? new Dictionary<long, tblBook>();

    int totalBooks = details.Count;
    int returnedBooks = details.Count(d => d.IsReturned);
    int remainingBooks = totalBooks - returnedBooks;
    bool isOverdue = Model.Status != "Đã trả" && DateTime.Now.Date > Model.DueDate.Date;
}

<main id="main" class="main">
    <!-- Breadcrumb & Title -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-area="Admin" asp-controller="Borrow" asp-action="Index" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Danh sách phiếu mượn
                </a>
                <span class="text-muted small">/</span>
                <span class="text-primary small fw-semibold">Chi tiết phiếu</span>
            </div>
            <h3 class="fw-bold mb-0 text-dark">
                Phiếu Mượn Sách: <span class="text-primary">@Model.Code</span>
            </h3>
        </div>

        <div class="d-flex align-items-center gap-2 mt-3 mt-md-0">
            @if (remainingBooks > 0)
            {
                <form method="post" asp-area="Admin" asp-controller="Borrow" asp-action="ReturnTicket" asp-route-id="@Model.TicketID"
                      onsubmit="return confirm('Xác nhận hoàn kho toàn bộ @remainingBooks cuốn sách còn lại cho phiếu mượn này?');">
                    <button type="submit" class="btn btn-success rounded-pill px-4 py-2 fw-semibold shadow-sm d-flex align-items-center gap-2">
                        <i class="bi bi-box-arrow-in-down-left"></i> Hoàn kho toàn bộ (@remainingBooks cuốn)
                    </button>
                </form>
            }
            <a asp-area="Admin" asp-controller="Borrow" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                Quay lại
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 1. THÔNG TIN TỔNG QUAN PHIẾU MƯỢN -->
    <div class="row g-3 mb-4">
        <!-- Cột trái: Thông tin phiếu & Độc giả -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
                <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle-fill text-primary"></i> Thông Tin Phiếu &amp; Độc Giả
                </h5>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted d-block mb-1">Mã phiếu mượn:</small>
                            <span class="badge" style="background: #eef2ff; color: #4338ca; font-weight: 700; font-size: 14px; padding: 6px 12px; border-radius: 8px;">
                                @Model.Code
                            </span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted d-block mb-1">Mã trả sách (khi hoàn tất):</small>
                            @if (!string.IsNullOrEmpty(Model.ReturnCode))
                            {
                                <span class="badge" style="background: #ecfdf5; color: #059669; font-weight: 700; font-size: 14px; padding: 6px 12px; border-radius: 8px;">
                                    @Model.ReturnCode
                                </span>
                            }
                            else
                            {
                                <span class="text-muted fw-semibold small">Chưa cấp (Đang mượn)</span>
                            }
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted d-block mb-1">Độc giả mượn sách:</small>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-secondary text-white small">@(user?.Code ?? $"DG{Model.UserID:D4}")</span>
                                <strong class="text-dark">@(user?.FullName ?? user?.UserName ?? "Bạn đọc #" + Model.UserID)</strong>
                            </div>
                            <small class="text-muted mt-1 d-block">Email: @(user?.Email ?? "Chưa cập nhật")</small>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted d-block mb-1">Ghi chú lúc mượn:</small>
                            <span class="text-dark small">@(string.IsNullOrWhiteSpace(Model.Note) ? "Không có ghi chú" : Model.Note)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Tiến độ hoàn kho & Thời hạn -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
                <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-primary"></i> Tiến Độ &amp; Hạn Trả
                </h5>

                <div class="mb-3">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Tiến độ hoàn kho:</span>
                        <span class="fw-bold text-dark">@returnedBooks/@totalBooks cuốn (@(totalBooks > 0 ? (returnedBooks * 100 / totalBooks) : 0)%)</span>
                    </div>
                    <div class="progress" style="height: 10px; border-radius: 20px;">
                        <div class="progress-bar bg-success" role="progressbar" 
                             style="width: @(totalBooks > 0 ? (returnedBooks * 100 / totalBooks) : 0)%;" 
                             aria-valuenow="@returnedBooks" aria-valuemin="0" aria-valuemax="@totalBooks"></div>
                    </div>
                </div>

                <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                    <li class="d-flex justify-content-between pb-2 border-bottom">
                        <span class="text-muted">Ngày mượn:</span>
                        <strong class="text-dark">@Model.BorrowDate.ToString("dd/MM/yyyy HH:mm")</strong>
                    </li>
                    <li class="d-flex justify-content-between pb-2 border-bottom">
                        <span class="text-muted">Hạn trả sách:</span>
                        @if (isOverdue)
                        {
                            <strong class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>@Model.DueDate.ToString("dd/MM/yyyy") (Quá hạn)</strong>
                        }
                        else
                        {
                            <strong class="text-dark">@Model.DueDate.ToString("dd/MM/yyyy")</strong>
                        }
                    </li>
                    <li class="d-flex justify-content-between pb-2 border-bottom">
                        <span class="text-muted">Ngày hoàn tất trả:</span>
                        <strong class="text-dark">@(Model.ReturnDate.HasValue ? Model.ReturnDate.Value.ToString("dd/MM/yyyy HH:mm") : "---")</strong>
                    </li>
                    <li class="d-flex justify-content-between pt-1">
                        <span class="text-muted">Trạng thái:</span>
                        @if (Model.Status == "Đã trả")
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Đã trả đủ sách</span>
                        }
                        else if (Model.Status == "Trả một phần")
                        {
                            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1">Đã trả một phần</span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1">Đang mượn</span>
                        }
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- 2. DANH SÁCH CHI TIẾT CÁC BẢN SÁCH MƯỢN (tblBorrowDetail) -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white py-3 px-4 border-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-journal-bookmark-fill text-primary me-2"></i> Danh Sách Chi Tiết Sách Trong Phiếu (@details.Count cuốn)
            </h5>
            <small class="text-muted">Mỗi bản sách được bảo đảm kiểm tra tồn kho và hoàn kho đúng 1 lần duy nhất</small>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 13.5px;">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 110px;">Mã sách</th>
                            <th style="width: 70px;">Bìa</th>
                            <th>Tên sách</th>
                            <th class="text-center" style="width: 140px;">Trạng thái kho</th>
                            <th class="text-center" style="width: 140px;">Ngày hoàn kho</th>
                            <th>Ghi chú hoàn kho</th>
                            <th class="text-center pe-4" style="width: 190px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (details.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    Không có cuốn sách nào trong chi tiết phiếu mượn này.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in details)
                            {
                                tblBook book = books.ContainsKey(item.BookID) ? books[item.BookID] : null;

                                <tr>
                                    <!-- Mã sách -->
                                    <td class="ps-4">
                                        <span class="badge" style="background: #eef2ff; color: #4338ca; font-weight: 700; font-size: 12.5px; padding: 6px 10px; border-radius: 6px;">
                                            @(book?.Code ?? $"MS{item.BookID:D4}")
                                        </span>
                                    </td>

                                    <!-- Bìa sách -->
                                    <td>
                                        <img src="@(book?.Images != null && book.Images.StartsWith("/") ? book.Images : "/" + (book?.Images ?? "images/books/book-placeholder.svg"))"
                                             alt="@(book?.Title ?? "Sách")" style="width: 42px; height: 58px; object-fit: cover; border-radius: 4px;"
                                             onerror="this.src='/images/books/book-placeholder.svg';" />
                                    </td>

                                    <!-- Tên sách -->
                                    <td>
                                        <strong class="text-dark">@(book?.Title ?? "Tài liệu #" + item.BookID)</strong>
                                        <div class="small text-muted">Năm XB: @(book?.PublishYear.ToString() ?? "---")</div>
                                    </td>

                                    <!-- Trạng thái hoàn kho từng cuốn -->
                                    <td class="text-center">
                                        @if (item.IsReturned)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                                <i class="bi bi-check-circle me-1"></i> Đã hoàn kho
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1">
                                                <i class="bi bi-book me-1"></i> Đang mượn
                                            </span>
                                        }
                                    </td>

                                    <!-- Ngày hoàn kho -->
                                    <td class="text-center text-muted">
                                        @(item.ReturnDate.HasValue ? item.ReturnDate.Value.ToString("dd/MM/yyyy HH:mm") : "---")
                                    </td>

                                    <!-- Ghi chú khi hoàn kho -->
                                    <td>
                                        <span class="text-secondary small">
                                            @(string.IsNullOrWhiteSpace(item.Note) ? "---" : item.Note)
                                        </span>
                                    </td>

                                    <!-- Nút hoàn kho từng cuốn -->
                                    <td class="text-center pe-4">
                                        @if (!item.IsReturned)
                                        {
                                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm"
                                                    data-bs-toggle="modal" data-bs-target="#returnSingleModal-@item.DetailID">
                                                <i class="bi bi-check2-circle me-1"></i> Hoàn kho cuốn này
                                            </button>

                                            <!-- Modal hoàn kho cuốn này -->
                                            <div class="modal fade" id="returnSingleModal-@item.DetailID" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content border-0 shadow-lg rounded-4">
                                                        <div class="modal-header bg-primary text-white">
                                                            <h5 class="modal-title fw-bold">
                                                                <i class="bi bi-journal-arrow-down me-2"></i> Xác Nhận Hoàn Kho
                                                            </h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <form method="post" asp-area="Admin" asp-controller="Borrow" asp-action="ReturnBookItem">
                                                            <input type="hidden" name="detailId" value="@item.DetailID" />
                                                            <div class="modal-body text-start p-4">
                                                                <p class="mb-2">Xác nhận hoàn kho cho cuốn sách:</p>
                                                                <div class="p-3 bg-light rounded-3 mb-3 border">
                                                                    <strong>[@(book?.Code)] @(book?.Title)</strong>
                                                                </div>
                                                                <div class="mb-3">
                                                                    <label class="form-label fw-semibold small">Ghi chú tình trạng sách lúc trả:</label>
                                                                    <input type="text" name="returnNote" class="form-control" placeholder="Ví dụ: Sách còn nguyên vẹn, không rách trang..." />
                                                                </div>
                                                                <div class="alert alert-info py-2 px-3 small rounded-3 mb-0">
                                                                    <i class="bi bi-shield-check me-1"></i> Hệ thống sử dụng thao tác nguyên tử, bảo đảm cuốn sách này chỉ được hoàn kho đúng một lần duy nhất.
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer border-0">
                                                                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                                                                <button type="submit" class="btn btn-success rounded-pill px-4 fw-semibold">
                                                                    <i class="bi bi-check-lg me-1"></i> Hoàn kho sách
                                                                </button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-success small fw-semibold">
                                                <i class="bi bi-check-all"></i> Đã hoàn tất
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>
