@using LibraryManagement.Models
@using LibraryManagement.Utilities
@model IList<tblBook>

@{
    ViewData["Title"] = "Trang Chủ - Cổng Tra Cứu Thư Viện Số";
    var authors = ViewBag.Authors as Dictionary<int, string>;
    var categories = ViewBag.Categories as List<tblCategory>;
}

<!-- 1. HERO BANNER SECTION (Thiết kế Gradient Visual Blue chuẩn Screenshot 2) -->
<div class="hero-gradient-box mb-4">
    <div class="row align-items-center g-4">
        <!-- Cột trái: Tiêu đề, mô tả và thanh tìm kiếm lớn -->
        <div class="col-lg-7">
            <!-- Badge pill -->
            <div class="hero-badge mb-3">
                <i class="bi bi-stars"></i> Không Gian Tri Thức &amp; Sáng Tạo Mở
            </div>

            <h1 class="hero-title text-white">
                Khám Phá Hàng Nghìn Đầu Sách &amp; Giáo Trình Trực Tuyến
            </h1>

            <p class="hero-subtitle">
                Tra cứu nhanh chóng vị trí sách trên kệ, đặt mượn tiện lợi mọi lúc mọi nơi và nhận hỗ trợ tự động từ Trợ lý Thư viện AI 24/7.
            </p>

            <!-- Big Search Box -->
            <form method="get" action="/" id="heroSearchForm" class="hero-search-wrapper mb-3">
                <i class="bi bi-search text-muted me-2 fs-5"></i>
                <input type="text" name="searchString" class="form-control hero-search-input" 
                       placeholder="Nhập tên sách, tác giả, mã ISBN hoặc chuyên ngành..." 
                       value="@ViewBag.SearchString">
                <button type="submit" class="hero-search-btn">
                    Tìm Kiếm Sách
                </button>
            </form>

            <!-- Popular Quick Keywords -->
            <div class="d-flex flex-wrap align-items-center gap-2 small text-white-50">
                <span class="text-white">Tìm kiếm phổ biến:</span>
                <a href="/?searchString=Clean Code" class="quick-chip">Clean Code</a>
                <a href="/?searchString=Mắt Biếc" class="quick-chip">Mắt Biếc</a>
                <a href="/?searchString=Trí Tuệ Nhân Tạo" class="quick-chip">Trí Tuệ Nhân Tạo</a>
                <a href="/?searchString=Đắc Nhân Tâm" class="quick-chip">Đắc Nhân Tâm</a>
            </div>
        </div>

        <!-- Cột phải: Hình ảnh vòm thư viện cong và floating badge 100% Trực Tuyến -->
        <div class="col-lg-5 text-center d-none d-lg-block">
            <div class="hero-img-card">
                <img src="/admin/assets/img/hero-library.jpg" class="w-100" style="height: 255px; object-fit: cover;" alt="Thư viện hiện đại" onerror="this.src='/admin/assets/img/card.jpg';">
                
                <!-- Floating Badge 100% Trực Tuyến -->
                <div class="hero-floating-badge">
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-success" 
                         style="width: 42px; height: 42px; background: #dcfce7; font-size: 20px;">
                        <i class="bi bi-journal-check"></i>
                    </div>
                    <div class="text-start">
                        <div class="fw-bold text-dark lh-sm" style="font-size: 13.5px;">100% Trực Tuyến</div>
                        <div class="text-muted" style="font-size: 11px;">Đặt mượn &amp; gia hạn nhanh</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 2. STATS COUNTER ROW (4 Thẻ trắng chỉ số nổi bật) -->
<div class="row g-3 mb-5">
    <div class="col-6 col-md-3">
        <div class="stat-card-modern">
            <div class="stat-card-number">12+</div>
            <div class="stat-card-label">Đầu sách trong thư viện</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card-modern">
            <div class="stat-card-number">127+</div>
            <div class="stat-card-label">Bản sách sẵn sàng phục vụ</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card-modern">
            <div class="stat-card-number">3+</div>
            <div class="stat-card-label">Độc giả đăng ký hoạt động</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card-modern">
            <div class="stat-card-number">24/7</div>
            <div class="stat-card-label">Hỗ trợ AI tra cứu liên tục</div>
        </div>
    </div>
</div>

<!-- 3. DANH MỤC THỂ LOẠI SÁCH (Section Header & Cards) -->
<div class="mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-3 d-flex align-items-center justify-content-center text-white shadow-sm" 
                 style="width: 44px; height: 44px; background: #4f46e5; font-size: 20px;">
                <i class="bi bi-grid-fill"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-0 text-dark" style="font-size: 22px; letter-spacing: -0.3px;">Danh Mục Thể Loại Sách</h4>
                <small class="text-muted" style="font-size: 13.5px;">Khám phá sách theo các chủ đề chuyên môn và lĩnh vực quan tâm</small>
            </div>
        </div>
        <a href="/?categoryId=0#kho-sach" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2 bg-white text-dark shadow-sm border fw-semibold mt-2 mt-sm-0">
            Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <!-- Category Cards Grid -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
        <div class="col">
            <a href="/?categoryId=2#kho-sach" class="category-card-modern">
                <div class="cat-icon-badge" style="background: #eff6ff; color: #2563eb;">
                    <i class="bi bi-laptop"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-dark mb-1">Công nghệ thông tin &amp; Lập trình</h6>
                    <small class="text-muted">C#, Java, Python, Web, Thuật toán</small>
                </div>
            </a>
        </div>
        <div class="col">
            <a href="/?categoryId=6#kho-sach" class="category-card-modern">
                <div class="cat-icon-badge" style="background: #f5f3ff; color: #7c3aed;">
                    <i class="bi bi-cpu"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-dark mb-1">Trí tuệ nhân tạo &amp; Dữ liệu</h6>
                    <small class="text-muted">Machine Learning, Big Data, LLM</small>
                </div>
            </a>
        </div>
        <div class="col">
            <a href="/?categoryId=3#kho-sach" class="category-card-modern">
                <div class="cat-icon-badge" style="background: #ecfdf5; color: #059669;">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-dark mb-1">Kinh tế &amp; Quản trị kinh doanh</h6>
                    <small class="text-muted">Khởi nghiệp, Tài chính, Marketing</small>
                </div>
            </a>
        </div>
        <div class="col">
            <a href="/?categoryId=5#kho-sach" class="category-card-modern">
                <div class="cat-icon-badge" style="background: #fffbeb; color: #d97706;">
                    <i class="bi bi-mortarboard"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-dark mb-1">Giáo trình &amp; Học phần đại học</h6>
                    <small class="text-muted">Tài liệu tham khảo chuyên ngành</small>
                </div>
            </a>
        </div>
        <div class="col">
            <a href="/?categoryId=1#kho-sach" class="category-card-modern">
                <div class="cat-icon-badge" style="background: #fdf2f8; color: #db2777;">
                    <i class="bi bi-feather"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-dark mb-1">Văn học Việt Nam &amp; Nước ngoài</h6>
                    <small class="text-muted">Tiểu thuyết, truyện ngắn, tác phẩm kinh điển</small>
                </div>
            </a>
        </div>
        <div class="col">
            <a href="/?categoryId=4#kho-sach" class="category-card-modern">
                <div class="cat-icon-badge" style="background: #eef2ff; color: #4f46e5;">
                    <i class="bi bi-heart-pulse"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-dark mb-1">Kỹ năng sống &amp; Phát triển bản thân</h6>
                    <small class="text-muted">Tâm lý học, tư duy lãnh đạo, giao tiếp</small>
                </div>
            </a>
        </div>
    </div>
</div>

<!-- 4. KHO SÁCH ĐANG PHỤC VỤ (Tra cứu & Mượn sách) -->
<div id="kho-sach" class="mb-5 pt-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-dark mb-1" style="font-size: 22px;">
                <i class="bi bi-book-half text-primary me-2"></i> Kho Sách Đang Sẵn Sàng Phục Vụ
            </h4>
            <div class="text-muted small">
                Hiển thị <strong>@Model.Count</strong> đầu sách có sẵn trên kệ thư viện
            </div>
        </div>

        <!-- Filter Category Pills -->
        <div class="d-flex flex-wrap gap-2 mt-2 mt-md-0">
            <a href="/#kho-sach" class="btn btn-sm rounded-pill px-3 @(ViewBag.SelectedCategory == null ? "btn-primary" : "btn-outline-secondary bg-white text-dark")">
                Tất cả sách
            </a>
            @if (categories != null)
            {
                foreach (var cat in categories)
                {
                    <a href="/?categoryId=@cat.CategoryID#kho-sach" 
                       class="btn btn-sm rounded-pill px-3 @(ViewBag.SelectedCategory == cat.CategoryID ? "btn-primary" : "btn-outline-secondary bg-white text-dark")">
                        @cat.CategoryName
                    </a>
                }
            }
        </div>
    </div>

    <!-- Book Grid Cards -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mt-1">
        @if (Model.Count == 0)
        {
            <div class="col-12 text-center py-5 bg-white rounded-4 shadow-sm">
                <i class="bi bi-inbox text-muted" style="font-size: 3.5rem;"></i>
                <h5 class="text-dark fw-bold mt-3">Không tìm thấy cuốn sách nào phù hợp!</h5>
                <p class="text-muted small">Hãy thử tìm kiếm với từ khóa khác hoặc bấm nút bên dưới để xem toàn bộ sách.</p>
                <a href="/" class="btn btn-primary rounded-pill px-4">Xem tất cả sách</a>
            </div>
        }
        else
        {
            foreach (var item in Model)
            {
                string detailUrl = Functions.TitlesSlugGeneration("/sach", item.Title, item.BookID);
                string authorName = authors != null && authors.ContainsKey(item.AuthorID) ? authors[item.AuthorID] : "Đang cập nhật";
                string coverImg = !string.IsNullOrEmpty(item.Images) ? item.Images : "/images/books/clean-code.svg";

                <div class="col">
                    <div class="book-card-pro">
                        <!-- Book Cover Image -->
                        <div class="book-img-wrap">
                            <a href="@detailUrl">
                                <img src="@coverImg" alt="@item.Title" onerror="this.src='/admin/assets/img/card.jpg';">
                            </a>
                            <!-- Badge số lượng tồn -->
                            <div class="position-absolute top-0 end-0 m-2">
                                @if (item.AvailableQuantity > 0)
                                {
                                    <span class="badge" style="background: rgba(22, 163, 74, 0.9); backdrop-filter: blur(4px); font-size: 11px;">
                                        Còn @item.AvailableQuantity cuốn
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger" style="font-size: 11px;">
                                        Đã hết sách
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Card Body Content -->
                        <div class="card-body p-3 d-flex flex-column flex-grow-1">
                            <h6 class="fw-bold mb-1" style="font-size: 14.5px; line-height: 1.35;">
                                <a href="@detailUrl" class="text-decoration-none text-dark hover-primary">
                                    @item.Title
                                </a>
                            </h6>

                            <div class="text-muted small mb-2 d-flex align-items-center gap-1" style="font-size: 12px;">
                                <i class="bi bi-person text-primary"></i> @authorName
                            </div>

                            <p class="text-secondary small mb-3 flex-grow-1" style="font-size: 12.5px; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @(string.IsNullOrEmpty(item.Summary) ? "Tài liệu học tập và tham khảo chính thức của thư viện trường học." : item.Summary)
                            </p>

                            <!-- Bottom Action -->
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="badge bg-light text-secondary border small" style="font-size: 10.5px;">
                                    Năm @item.PublishYear
                                </span>
                                <a href="@detailUrl" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-semibold" style="font-size: 12.5px;">
                                    Chi tiết <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
