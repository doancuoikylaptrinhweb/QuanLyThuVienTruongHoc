@using LibraryManagement.Models
@model IList<tblBorrowTicket>

@{
    ViewData["Title"] = "Quản lý Mượn / Trả Sách";
    var users = ViewBag.Users as Dictionary<int, tblUser>;
    var ticketDetails = ViewBag.TicketDetails as Dictionary<int, List<tblBorrowDetail>>;
    var books = ViewBag.Books as Dictionary<long, tblBook>;
}

<main id="main" class="main">
    <div class="pagetitle mb-3">
        <h2>Quản lý Mượn &amp; Trả Sách</h2>
        <p class="text-muted small mb-0">Theo dõi phiếu mượn, xác nhận trả từng cuốn hoặc toàn bộ &mdash; hỗ trợ nhiều sách trên một phiếu với kiểm tra tồn kho nguyên tử.</p>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Action Toolbar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-7">
                    <form method="get" asp-area="Admin" asp-controller="Borrow" asp-action="Index" class="d-flex gap-2">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                            <input type="text" name="keyword" class="form-control border-start-0"
                                   placeholder="Tra cứu theo Mã phiếu (PM...), Mã trả (PT...), Mã độc giả (DG...), Mã sách (MS...)..."
                                   value="@ViewBag.Keyword">
                        </div>
                        <button type="submit" class="btn btn-primary px-3 fw-semibold">
                            Tìm kiếm
                        </button>
                        @if (!string.IsNullOrEmpty(ViewBag.Keyword as string))
                        {
                            <a asp-area="Admin" asp-controller="Borrow" asp-action="Index" class="btn btn-light border px-3">
                                Xóa lọc
                            </a>
                        }
                    </form>
                </div>
                <div class="col-md-5 text-md-end">
                    <a class="btn btn-warning rounded-pill px-3 py-2 fw-semibold shadow-sm me-2 text-dark" asp-area="Admin" asp-controller="Borrow" asp-action="PendingRequests">
                        <i class="bi bi-clock-history me-1"></i> Yêu cầu chờ duyệt
                    </a>
                    <a class="btn btn-success rounded-pill px-4 py-2 fw-semibold shadow-sm" asp-area="Admin" asp-controller="Borrow" asp-action="Create">
                        <i class="bi bi-plus-circle me-1"></i> Lập phiếu mượn mới
                    </a>
                </div>
            </div>
        </div>
    </div>

    <section class="section dashboard">
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-body p-4">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" style="font-size: 13.5px;">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-center">Mã phiếu</th>
                                        <th class="text-center">Mã trả</th>
                                        <th>Độc giả</th>
                                        <th>Sách mượn</th>
                                        <th class="text-center">Ngày mượn</th>
                                        <th class="text-center">Hạn trả</th>
                                        <th class="text-center">Trạng thái</th>
                                        <th class="text-center">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model == null || Model.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center py-5 text-muted">
                                                <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                                                Chưa có phiếu mượn nào phù hợp với điều kiện tìm kiếm.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in Model)
                                        {
                                            tblUser user = null;
                                            if (users != null && users.ContainsKey(item.UserID))
                                                user = users[item.UserID];

                                            List<tblBorrowDetail> details = null;
                                            int totalBooks = 0, returnedBooks = 0;
                                            if (ticketDetails != null && ticketDetails.ContainsKey(item.TicketID))
                                            {
                                                details = ticketDetails[item.TicketID];
                                                totalBooks = details.Count;
                                                returnedBooks = details.Count(d => d.IsReturned);
                                            }

                                            bool isOverdue = item.Status == "Đang mượn" && DateTime.Now.Date > item.DueDate.Date;
                                            bool isPartial = item.Status == "Trả một phần";

                                            <tr>
                                                <!-- Mã phiếu mượn -->
                                                <td class="text-center">
                                                    <span class="badge" style="background:#eef2ff;color:#4338ca;font-weight:700;font-size:12.5px;padding:6px 10px;border-radius:6px;">
                                                        @item.Code
                                                    </span>
                                                </td>

                                                <!-- Mã trả sách -->
                                                <td class="text-center">
                                                    @if (item.Status == "Đã trả")
                                                    {
                                                        <span class="badge" style="background:#ecfdf5;color:#059669;font-weight:700;font-size:12.5px;padding:6px 10px;border-radius:6px;">
                                                            @item.DisplayReturnCode
                                                        </span>
                                                    }
                                                    else if (isPartial)
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" style="font-size:11px;">
                                                            Đang trả...
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">---</span>
                                                    }
                                                </td>

                                                <!-- Độc giả kèm mã -->
                                                <td>
                                                    <div class="d-flex align-items-center gap-1">
                                                        <span class="badge bg-light text-dark border small fw-semibold">
                                                            @(user != null ? user.Code : $"DG{item.UserID:D4}")
                                                        </span>
                                                        <strong class="text-dark">@(user != null ? (user.FullName ?? user.UserName) : "Độc giả #" + item.UserID)</strong>
                                                    </div>
                                                </td>

                                                <!-- Sách mượn (multi-book summary) -->
                                                <td>
                                                    @if (totalBooks > 0)
                                                    {
                                                        <div class="d-flex flex-column gap-1">
                                                            <span class="fw-semibold text-dark">
                                                                <i class="bi bi-books me-1 text-primary"></i>@totalBooks cuốn sách
                                                            </span>
                                                            @if (details != null)
                                                            {
                                                                @foreach (var d in details.Take(2))
                                                                {
                                                                    tblBook bk = (books != null && books.ContainsKey(d.BookID)) ? books[d.BookID] : null;
                                                                    <div class="d-flex align-items-center gap-1">
                                                                        <span class="badge bg-light text-primary border border-primary-subtle small fw-semibold">
                                                                            @(bk != null ? bk.Code : $"MS{d.BookID:D4}")
                                                                        </span>
                                                                        <span class="text-muted small text-truncate" style="max-width:160px;" title="@(bk?.Title)">
                                                                            @(bk != null ? bk.Title : "...")
                                                                        </span>
                                                                        @if (d.IsReturned)
                                                                        {
                                                                            <i class="bi bi-check-circle-fill text-success ms-1" title="Đã trả"></i>
                                                                        }
                                                                    </div>
                                                                }
                                                                @if (totalBooks > 2)
                                                                {
                                                                    <span class="text-muted small">... và @(totalBooks - 2) cuốn khác</span>
                                                                }
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Tài liệu thư viện</span>
                                                    }
                                                </td>

                                                <!-- Ngày mượn -->
                                                <td class="text-center text-muted">@item.BorrowDate.ToString("dd/MM/yyyy")</td>

                                                <!-- Hạn trả -->
                                                <td class="text-center">
                                                    @if (isOverdue)
                                                    {
                                                        <span class="text-danger fw-bold" title="Phiếu đã quá hạn!">
                                                            <i class="bi bi-exclamation-circle me-1"></i>@item.DueDate.ToString("dd/MM/yyyy")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span>@item.DueDate.ToString("dd/MM/yyyy")</span>
                                                    }
                                                </td>

                                                <!-- Trạng thái -->
                                                <td class="text-center">
                                                    @if (item.Status == "Đã trả")
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Đã trả sách</span>
                                                    }
                                                    else if (item.Status == "Chờ duyệt trả")
                                                    {
                                                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1">Chờ duyệt trả</span>
                                                    }
                                                    else if (item.Status == "Pending")
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1">Chờ duyệt mượn</span>
                                                    }
                                                    else if (isPartial)
                                                    {
                                                        <div>
                                                            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1 d-block mb-1">Trả một phần</span>
                                                            <small class="text-muted">@returnedBooks/@totalBooks cuốn</small>
                                                        </div>
                                                    }
                                                    else if (isOverdue)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">Quá hạn trả</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">Đang mượn</span>
                                                    }
                                                </td>

                                                <!-- Thao tác -->
                                                <td class="text-center">
                                                    <div class="d-flex gap-1 justify-content-center flex-wrap">
                                                        <!-- Nút xem chi tiết -->
                                                        <a asp-area="Admin" asp-controller="Borrow" asp-action="Detail" asp-route-id="@item.TicketID"
                                                           class="btn btn-sm btn-outline-primary rounded-pill px-3" title="Xem chi tiết phiếu và trả từng cuốn">
                                                            <i class="bi bi-eye me-1"></i>Chi tiết
                                                        </a>

                                                        @if (item.Status != "Đã trả")
                                                        {
                                                            <!-- Nút trả nhanh toàn bộ -->
                                                            <form method="post" asp-area="Admin" asp-controller="Borrow" asp-action="ReturnBook" asp-route-id="@item.TicketID"
                                                                  onsubmit="return confirm('Xác nhận trả toàn bộ sách cho phiếu [@item.Code]? Thao tác này sẽ hoàn kho tất cả cuốn chưa trả.');"
                                                                  style="display:inline-block;">
                                                                <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" title="Trả nhanh toàn bộ">
                                                                    <i class="bi bi-check2-all me-1"></i>Trả tất cả
                                                                </button>
                                                            </form>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-success small fw-semibold">
                                                                <i class="bi bi-check-all"></i> Hoàn tất
                                                            </span>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
