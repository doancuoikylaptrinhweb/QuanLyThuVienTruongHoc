@using LibraryManagement.Models
@model IList<tblBorrowTicket>

@{
    ViewData["Title"] = "Bảng Điều Khiển Thư Viện";
    var users = ViewBag.Users as Dictionary<int, string>;
}

<main id="main" class="main">

    <!-- Page Header & Action Buttons -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm" 
                 style="width: 44px; height: 44px; background: #7c3aed; font-size: 20px;">
                <i class="bi bi-journal-richtext"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-0 text-dark" style="font-size: 22px; letter-spacing: -0.3px;">Bảng Điều Khiển Thư Viện</h4>
                <small class="text-muted" style="font-size: 13px;">
                    Hệ thống quản lý thời gian thực - Cập nhật lúc @DateTime.Now.ToString("HH:mm - dd/MM/yyyy")
                </small>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a href="/Admin/Borrow/Create" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2 bg-white text-dark shadow-sm border rounded-3 fw-semibold">
                <i class="bi bi-plus-circle text-primary"></i> Lập phiếu mượn mới
            </a>
            <a href="/Admin/Book/Create" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2 bg-white text-dark shadow-sm border rounded-3 fw-semibold">
                <i class="bi bi-plus-square text-primary"></i> Nhập sách mới
            </a>
        </div>
    </div>

    <!-- 4 Statistic Cards in a row -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Tổng đầu sách -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="display-6 fw-bold text-dark lh-1 mb-2" style="font-size: 32px;">@ViewBag.TotalBooks</div>
                        <div class="text-muted small fw-medium" style="font-size: 13px;">Tổng đầu sách (@(ViewBag.TotalCopies) bản)</div>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" 
                         style="width: 48px; height: 48px; background: #eff6ff; color: #2563eb; font-size: 22px;">
                        <i class="bi bi-book"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Phiếu đang mượn đọc -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="display-6 fw-bold lh-1 mb-2" style="font-size: 32px; color: #16a34a;">@ViewBag.TotalBorrowing</div>
                        <div class="text-muted small fw-medium" style="font-size: 13px;">Phiếu đang mượn đọc</div>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" 
                         style="width: 48px; height: 48px; background: #f0fdf4; color: #16a34a; font-size: 22px;">
                        <i class="bi bi-journal-bookmark"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Sách quá hạn trả -->
        <div class="col-12 col-sm-6 col-xl-3">
            <a href="/Admin/OverdueWarning" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="display-6 fw-bold lh-1 mb-2" style="font-size: 32px; color: #dc2626;">@(ViewBag.TotalOverdueBooks ?? 0)</div>
                            <div class="text-muted small fw-medium" style="font-size: 13px;">Sách quá hạn (@(ViewBag.TotalOverdue ?? 0) phiếu)</div>
                        </div>
                        <div class="rounded-3 d-flex align-items-center justify-content-center" 
                             style="width: 48px; height: 48px; background: #fef2f2; color: #dc2626; font-size: 22px;">
                            <i class="bi bi-exclamation-octagon"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Card 4: Yêu cầu mượn chờ duyệt -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="display-6 fw-bold lh-1 mb-2" style="font-size: 32px; color: #d97706;">@ViewBag.TotalPending</div>
                        <div class="text-muted small fw-medium" style="font-size: 13px;">Yêu cầu mượn chờ duyệt</div>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" 
                         style="width: 48px; height: 48px; background: #fffbeb; color: #d97706; font-size: 22px;">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row: Xu Hướng Mượn/Trả & Cơ Cấu Thể Loại -->
    <div class="row g-3 mb-4">
        <!-- Chart 1: Xu hướng Mượn & Trả Sách -->
        <div class="col-12 col-xl-7">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 16px;">
                        <i class="bi bi-bar-chart-line text-primary"></i> Xu Hướng Mượn & Trả Sách (6 Tháng Gần Nhất)
                    </div>
                    <span class="badge bg-light text-secondary border px-3 py-2 fw-medium rounded-pill" style="font-size: 12px;">Biểu đồ đối sánh</span>
                </div>
                <!-- ApexCharts bar container -->
                <div id="borrowTrendChart" style="min-height: 290px;"></div>
            </div>
        </div>

        <!-- Chart 2: Cơ Cấu Thể Loại Sách -->
        <div class="col-12 col-xl-5">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 16px;">
                        <i class="bi bi-pie-chart text-primary"></i> Cơ Cấu Thể Loại Sách
                    </div>
                </div>
                <!-- ApexCharts donut container -->
                <div id="categoryDonutChart" style="min-height: 290px;"></div>
            </div>
        </div>
    </div>

    <!-- Overdue Warnings Row: Top 5 Cảnh Báo Sách Quá Hạn Nghiêm Trọng Nhất -->
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: #fef2f2; color: #dc2626;">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark" style="font-size: 16px;">Cảnh Báo Sách Quá Hạn Nghiêm Trọng Nhất</div>
                            <small class="text-muted">Hiển thị tối đa 5 cảnh báo đã gộp theo phiếu mượn có số ngày quá hạn cao nhất</small>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="badge rounded-pill px-3 py-2" style="background: #fef9c3; color: #a16207; font-weight: 600;">
                            Nhắc nhở (1–3 ngày): @(ViewBag.OverdueReminderCount ?? 0)
                        </span>
                        <span class="badge rounded-pill px-3 py-2" style="background: #ffedd5; color: #c2410c; font-weight: 600;">
                            Cảnh báo (4–7 ngày): @(ViewBag.OverdueWarningCount ?? 0)
                        </span>
                        <span class="badge rounded-pill px-3 py-2" style="background: #fee2e2; color: #b91c1c; font-weight: 600;">
                            Nghiêm trọng (&gt;7 ngày): @(ViewBag.OverdueCriticalCount ?? 0)
                        </span>
                        <a href="/Admin/OverdueWarning" class="btn btn-sm btn-danger rounded-3 fw-semibold px-3 py-1 ms-1">
                            Quản lý chi tiết <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 13.5px;">
                        <thead>
                            <tr class="text-muted text-uppercase" style="font-size: 11px; letter-spacing: 0.6px; border-bottom: 2px solid #f1f5f9;">
                                <th class="py-2">MÃ PHIẾU</th>
                                <th class="py-2">ĐỘC GIẢ</th>
                                <th class="py-2">SÁCH QUÁ HẠN (ĐÃ GỘP)</th>
                                <th class="py-2">HẠN TRẢ</th>
                                <th class="py-2 text-center">QUÁ HẠN</th>
                                <th class="py-2 text-center">MỨC ĐỘ</th>
                                <th class="py-2 text-center">TRẠNG THÁI XỬ LÝ</th>
                                <th class="py-2 text-center">CHI TIẾT</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.TopOverdueWarnings != null && ((IEnumerable<dynamic>)ViewBag.TopOverdueWarnings).Any())
                            {
                                foreach (var w in (IEnumerable<dynamic>)ViewBag.TopOverdueWarnings)
                                {
                                    string sevBg = w.SeverityLevel == "Nghiêm trọng" ? "#fee2e2" : (w.SeverityLevel == "Cảnh báo" ? "#ffedd5" : "#fef9c3");
                                    string sevColor = w.SeverityLevel == "Nghiêm trọng" ? "#b91c1c" : (w.SeverityLevel == "Cảnh báo" ? "#c2410c" : "#a16207");
                                    string stBg = w.WarningStatus == "Đã nhắc nhở" ? "#dcfce7" : "#f1f5f9";
                                    string stColor = w.WarningStatus == "Đã nhắc nhở" ? "#15803d" : "#475569";
                                    <tr>
                                        <td>
                                            <span class="badge" style="background: #eef2ff; color: #4338ca; font-weight: 600; padding: 6px 10px; border-radius: 6px;">
                                                @w.TicketCode
                                            </span>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark">@w.ReaderName</div>
                                            <small class="text-muted">@w.ReaderCode</small>
                                        </td>
                                        <td style="max-width: 280px;">
                                            <div class="text-dark fw-medium text-truncate" title="@w.BookTitles">@w.BookTitles</div>
                                            <small class="text-muted">@w.OverdueBookCount cuốn chưa trả (@w.TicketStatus)</small>
                                        </td>
                                        <td class="text-secondary">@w.DueDate.ToString("dd/MM/yyyy")</td>
                                        <td class="text-center fw-bold text-danger">@w.OverdueDays ngày</td>
                                        <td class="text-center">
                                            <span class="badge rounded-pill px-3 py-1" style="background: @sevBg; color: @sevColor; font-weight: 600;">
                                                @w.SeverityLevel
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge rounded-pill px-3 py-1" style="background: @stBg; color: @stColor; font-weight: 600;">
                                                @w.WarningStatus
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <a href="/Admin/OverdueWarning" class="btn btn-sm btn-light border rounded-circle" title="Xử lý cảnh báo" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                                                <i class="bi bi-eye text-primary"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        <i class="bi bi-check-circle text-success fs-4 d-block mb-1"></i>
                                        Hiện tại không có sách quá hạn nào trong hệ thống.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Row: Phiếu Mượn Gần Đây & Top Sách Mượn Nhiều -->
    <div class="row g-3">
        <!-- Left: Phiếu Mượn Gần Đây -->
        <div class="col-12 col-xl-7">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 16px;">
                        <i class="bi bi-clock-history text-primary"></i> Phiếu Mượn Gần Đây
                    </div>
                    <a href="/Admin/Borrow" class="btn btn-sm btn-link text-primary text-decoration-none fw-semibold">
                        Xem tất cả <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 13.5px;">
                        <thead>
                            <tr class="text-muted text-uppercase" style="font-size: 11px; letter-spacing: 0.6px; border-bottom: 2px solid #f1f5f9;">
                                <th scope="col" class="py-2">MÃ PHIẾU</th>
                                <th scope="col" class="py-2">ĐỘC GIẢ</th>
                                <th scope="col" class="py-2">HẠN TRẢ</th>
                                <th scope="col" class="py-2">TRẠNG THÁI</th>
                                <th scope="col" class="py-2 text-center">HÀNH ĐỘNG</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var t in Model)
                                {
                                    string userName = users != null && users.ContainsKey(t.UserID) ? users[t.UserID] : "Lê Hoàng Nam (Sinh Viên)";
                                    string ticketCode = !string.IsNullOrEmpty(t.Note) && t.Note.StartsWith("PM-") ? t.Note : $"PM-202611-{t.TicketID:D3}";
                                    <tr>
                                        <td class="fw-semibold">
                                            <span class="badge" style="background: #eef2ff; color: #4338ca; font-weight: 600; padding: 6px 10px; border-radius: 6px;">
                                                @ticketCode
                                            </span>
                                        </td>
                                        <td>
                                            <div class="fw-medium text-dark">@userName</div>
                                        </td>
                                        <td class="text-secondary">@t.DueDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (t.Status == "Đang mượn")
                                            {
                                                <span class="badge" style="background: #dcfce7; color: #15803d; font-weight: 600; padding: 6px 12px; border-radius: 50px;">
                                                    Đang mượn
                                                </span>
                                            }
                                            else if (t.Status == "Quá hạn")
                                            {
                                                <span class="badge" style="background: #fee2e2; color: #b91c1c; font-weight: 600; padding: 6px 12px; border-radius: 50px;">
                                                    Quá hạn
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary" style="font-weight: 600; padding: 6px 12px; border-radius: 50px;">
                                                    @t.Status
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <a href="/Admin/Borrow" class="btn btn-sm btn-light border rounded-circle" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                                                <i class="bi bi-eye text-secondary"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        <i class="bi bi-inbox fs-3 d-block mb-1 opacity-50"></i>
                                        Chưa có phiếu mượn nào được ghi nhận trong hệ thống.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right: Top Sách Mượn Nhiều (100% TRUY VẤN TỪ DATABASE) -->
        <div class="col-12 col-xl-5">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 16px;">
                        <i class="bi bi-fire text-danger"></i> Top Sách Mượn Nhiều
                    </div>
                    <a href="/Admin/Book" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 bg-white border text-dark fw-medium" style="font-size: 12px;">
                        Kho sách
                    </a>
                </div>

                <div class="d-flex flex-column gap-3">
                    @if (ViewBag.TopBooks != null && ((IEnumerable<dynamic>)ViewBag.TopBooks).Any())
                    {
                        foreach (var bk in (IEnumerable<dynamic>)ViewBag.TopBooks)
                        {
                            <div class="d-flex align-items-center gap-3 p-2 rounded-3" style="background: #f8fafc; border: 1px solid #f1f5f9;">
                                <img src="@(bk.Image != null && bk.Image.StartsWith("/") ? bk.Image : "/" + bk.Image)" 
                                     class="rounded-2 shadow-sm" style="width: 44px; height: 60px; object-fit: cover;" 
                                     alt="@bk.Title" onerror="this.src='/images/books/book-placeholder.svg';">
                                <div class="flex-grow-1 overflow-hidden">
                                    <h6 class="fw-bold text-dark mb-1 text-truncate" style="font-size: 13.5px;" title="@bk.Title">@bk.Title</h6>
                                    <div class="text-muted small mb-1" style="font-size: 11.5px;">Tác giả: @bk.Author</div>
                                    <span class="badge bg-white text-secondary border" style="font-size: 10.5px;">Mã: @bk.Code</span>
                                </div>
                                <div class="text-end">
                                    @if (bk.BorrowCount > 0)
                                    {
                                        <span class="badge" style="background: #4338ca; color: #ffffff; border-radius: 50px; font-weight: 600; font-size: 11px;">
                                            @bk.BorrowCount lượt
                                        </span>
                                    }
                                    <div class="text-muted small mt-1" style="font-size: 11px;">Còn @bk.AvailableQuantity</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-inbox fs-3 d-block mb-1 opacity-50"></i>
                            Chưa có dữ liệu sách trong kho.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</main>

<!-- ApexCharts Script Initialization -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. BIỂU ĐỒ XU HƯỚNG MƯỢN & TRẢ SÁCH (Grouped Columns)
        var trendOptions = {
            series: [
                {
                    name: 'Lượt mượn sách',
                    data: [0, 0, 0, 0, 2, 1]
                },
                {
                    name: 'Lượt trả sách',
                    data: [0, 0, 0, 0, 1, 0]
                }
            ],
            chart: {
                type: 'bar',
                height: 290,
                toolbar: { show: false },
                fontFamily: 'inherit'
            },
            plotOptions: {
                bar: {
                    horizontal: false,
                    columnWidth: '40%',
                    borderRadius: 4
                }
            },
            dataLabels: { enabled: false },
            stroke: { show: true, width: 2, colors: ['transparent'] },
            colors: ['#3b82f6', '#60a5fa'],
            xaxis: {
                categories: ['T6/2026', 'T7/2026', 'T8/2026', 'T9/2026', 'T10/2026', 'T11/2026'],
                labels: { style: { colors: '#64748b', fontSize: '12px' } }
            },
            yaxis: {
                min: 0,
                max: 2,
                tickAmount: 2,
                labels: { style: { colors: '#64748b', fontSize: '12px' } }
            },
            grid: {
                borderColor: '#f1f5f9',
                strokeDashArray: 3
            },
            legend: {
                position: 'top',
                horizontalAlign: 'center',
                labels: { colors: '#334155' }
            },
            tooltip: {
                y: {
                    formatter: function (val) {
                        return val + " lượt";
                    }
                }
            }
        };
        var trendChart = new ApexCharts(document.querySelector("#borrowTrendChart"), trendOptions);
        trendChart.render();

        // 2. BIỂU ĐỒ CƠ CẤU THỂ LOẠI SÁCH (Donut)
        var catOptions = {
            series: [35, 20, 15, 12, 10, 8],
            chart: {
                type: 'donut',
                height: 290,
                fontFamily: 'inherit'
            },
            labels: [
                'Văn học Việt Nam',
                'Văn học nước ngoài',
                'Công nghệ thông tin & Lập trình',
                'Trí tuệ nhân tạo & Dữ liệu',
                'Toán học & Khoa học cơ bản',
                'Kinh tế & Quản trị kinh doanh'
            ],
            colors: ['#2563eb', '#38bdf8', '#06b6d4', '#10b981', '#f59e0b', '#8b5cf6'],
            legend: {
                position: 'bottom',
                fontSize: '11px',
                labels: { colors: '#475569' },
                itemMargin: { horizontal: 6, vertical: 2 }
            },
            dataLabels: { enabled: false },
            plotOptions: {
                pie: {
                    donut: {
                        size: '62%'
                    }
                }
            },
            stroke: { width: 2, colors: ['#ffffff'] }
        };
        var catChart = new ApexCharts(document.querySelector("#categoryDonutChart"), catOptions);
        catChart.render();
    });
</script>
