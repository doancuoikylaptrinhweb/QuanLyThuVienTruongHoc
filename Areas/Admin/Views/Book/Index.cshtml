@using LibraryManagement.Models
@using PagedList.Core.Mvc
@model PagedList.Core.IPagedList<tblBook>

<main id="main" class="main">
    <div class="pagetitle mb-3">
        <h2>Kho Sách Thư Viện</h2>
        <p class="text-muted small mb-0">Quản lý danh mục sách, số lượng tồn kho và mã sách chuẩn hóa (MS0001, MS0002...)</p>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Action Toolbar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-7">
                    <form method="get" asp-area="Admin" asp-controller="Book" asp-action="Index" class="d-flex gap-2">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                            <input type="text" name="keyword" class="form-control border-start-0" 
                                   placeholder="Tìm theo Tên sách, Mã sách (MS...)..." 
                                   value="@ViewBag.Keyword">
                        </div>
                        <button type="submit" class="btn btn-primary px-3 fw-semibold">
                            Tìm kiếm
                        </button>
                        @if (!string.IsNullOrEmpty(ViewBag.Keyword as string))
                        {
                            <a asp-area="Admin" asp-controller="Book" asp-action="Index" class="btn btn-light border px-3">
                                Xóa lọc
                            </a>
                        }
                    </form>
                </div>
                <div class="col-md-5 text-md-end">
                    <a class="btn btn-success rounded-pill px-4 py-2 fw-semibold shadow-sm" asp-area="Admin" asp-controller="Book" asp-action="Create">
                        <i class="bi bi-plus-circle me-1"></i> Thêm sách mới
                    </a>
                </div>
            </div>
        </div>
    </div>

    <section class="section dashboard">
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-body p-4">
                        <table class="table table-hover align-middle mb-0" style="font-size: 13.5px;">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center" style="width: 100px;">Mã sách</th>
                                    <th class="text-center" style="width: 80px;">Ảnh bìa</th>
                                    <th>Tên sách</th>
                                    <th class="text-center">Tổng kho</th>
                                    <th class="text-center">Khả dụng</th>
                                    <th class="text-center">Trạng thái</th>
                                    <th class="text-center">Chức năng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <!-- Mã sách -->
                                        <td class="text-center">
                                            <span class="badge" style="background: #eef2ff; color: #4338ca; font-weight: 700; font-size: 12.5px; padding: 6px 10px; border-radius: 6px;">
                                                @item.Code
                                            </span>
                                        </td>
                                        <td class="text-center" style="width: 80px;">
                                            <img src="@(item.Images != null && item.Images.StartsWith("/") ? item.Images : "/" + item.Images)" 
                                                 alt="@item.Title" style="width: 50px; height: 70px; object-fit: cover; border-radius: 6px;" onerror="this.src='/images/books/book-placeholder.svg';" />
                                        </td>
                                        <td>
                                            <strong class="text-dark">@item.Title</strong>
                                            <div class="small text-muted">Năm XB: @item.PublishYear</div>
                                        </td>
                                        <td class="text-center fw-semibold">@item.Quantity</td>
                                        <td class="text-center fw-bold text-success">@item.AvailableQuantity</td>
                                        <td class="text-center">
                                            @if (item.IsActive == true)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Hiển thị</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">Ẩn</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <form method="post" asp-area="Admin" asp-controller="Book" asp-action="Delete" asp-route-id="@item.BookID" 
                                                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa cuốn sách [@item.Code]?');" style="display:inline-block;">
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Xóa sách">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <!-- PHÂN TRANG -->
                        <div class="d-flex justify-content-center mt-4">
                            <pager class="pager-container" list="@Model" asp-area="Admin" asp-controller="Book" asp-action="Index" />
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
