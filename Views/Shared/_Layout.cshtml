        </div>

        <div class="chat-window-body" id="modernChatMessages">
            <div class="chat-bubble chat-bot-bubble">
                👋 Xin chào! Tôi là <strong>Trợ lý Ảo AI Thư viện</strong>. Bạn cần tìm sách gì, hướng dẫn thủ tục hay vị trí sách trên kệ nào hôm nay?
            </div>
        </div>

        <!-- Quick Suggestions -->
        <div class="px-3 py-2 bg-white border-top d-flex gap-1 overflow-auto" style="white-space: nowrap;">
            <button class="btn btn-outline-primary btn-sm py-0 rounded-pill" style="font-size: 12px;" onclick="sendModernQuick('Gợi ý sách hay')">Gợi ý sách</button>
            <button class="btn btn-outline-primary btn-sm py-0 rounded-pill" style="font-size: 12px;" onclick="sendModernQuick('Quy định mượn sách')">Quy định mượn</button>
            <button class="btn btn-outline-primary btn-sm py-0 rounded-pill" style="font-size: 12px;" onclick="sendModernQuick('Tìm sách Clean Code')">Clean Code</button>
        </div>

        <div class="p-2 bg-white border-top d-flex gap-2">
            <input type="text" id="modernChatInput" class="form-control form-control-sm rounded-pill px-3" placeholder="Nhập câu hỏi của bạn..." onkeypress="handleModernKey(event)">
            <button class="btn btn-primary btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; flex-shrink: 0;" onclick="sendModernMessage()">
                <i class="bi bi-send-fill" style="font-size: 13px;"></i>
            </button>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/admin/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <script>
        function toggleModernChat() {
            var chat = document.getElementById("modern-chat-window");
            chat.style.display = (chat.style.display === "flex") ? "none" : "flex";
            if (chat.style.display === "flex") {
                document.getElementById("modernChatInput").focus();
            }
        }

        function handleModernKey(e) {
            if (e.key === "Enter") sendModernMessage();
        }

        function sendModernQuick(text) {
            document.getElementById("modernChatInput").value = text;
            sendModernMessage();
        }

        function sendModernMessage() {
            var input = document.getElementById("modernChatInput");
            var message = input.value.trim();
            if (!message) return;

            var container = document.getElementById("modernChatMessages");
            container.innerHTML += '<div class="chat-bubble chat-user-bubble">' + message + '</div>';
            input.value = "";
            container.scrollTop = container.scrollHeight;

            var formData = new FormData();
            formData.append("message", message);

            fetch('/Home/ChatBot', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                container.innerHTML += '<div class="chat-bubble chat-bot-bubble">' + data.reply + '</div>';
                container.scrollTop = container.scrollHeight;
            })
            .catch(err => {
                container.innerHTML += '<div class="chat-bubble chat-bot-bubble text-danger">Có lỗi kết nối, vui lòng thử lại!</div>';
                container.scrollTop = container.scrollHeight;
            });
        }

        // Mở Modal Xác Thực (Đăng Nhập hoặc Đăng Ký)
        function openAuthModal(mode) {
            var modalEl = document.getElementById('loginModal');
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
            switchAuthTab(mode || 'login');
        }

        // Chuyển đổi giao diện và thông tin theo chế độ Đăng Nhập hoặc Đăng Ký
        function onSwitchAuthMode(mode) {
            var header = document.getElementById("authModalHeader");
            var title = document.getElementById("loginModalLabel");
            var sub = document.getElementById("authModalSubTitle");
            var icon = document.getElementById("authModalIcon");

            if (mode === 'register') {
                if (header) {
                    header.className = "modal-header text-white pb-3";
                    header.style.background = "linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%)";
                }
                if (title) title.textContent = "Đăng Ký Tài Khoản Bạn Đọc";
                if (sub) sub.textContent = "Cấp mã thẻ thư viện & kích hoạt quyền mượn sách trực tuyến";
                if (icon) icon.className = "bi bi-person-plus-fill fs-4";
                clearRegisterForm();
                setTimeout(clearRegisterForm, 60);
            } else {
                if (header) {
                    header.className = "modal-header bg-primary text-white pb-3";
                    header.style.background = "";
                }
                if (title) title.textContent = "Cổng Xác Thực Bạn Đọc";
                if (sub) sub.textContent = "Đăng nhập để tra cứu, mượn sách hoặc theo dõi phiếu mượn";
                if (icon) icon.className = "bi bi-shield-lock-fill fs-4";
                clearLoginForm();
                setTimeout(clearLoginForm, 60);
            }
        }

        // Xóa trắng hoàn toàn form đăng nhập, ngăn trình duyệt / cache tự điền tài khoản cũ
        function clearLoginForm() {
            var f = document.getElementById("clientLoginForm");
            if (f) f.reset();
            var u = document.getElementById("clientLoginUser");
            if (u) {
                u.value = "";
                u.setAttribute("readonly", "readonly");
            }
            var p = document.getElementById("clientLoginPass");
            if (p) {
                p.value = "";
                p.type = "password";
                p.setAttribute("readonly", "readonly");
            }
            var icon = document.getElementById("loginPassToggleIcon");
            if (icon) icon.className = "bi bi-eye";
            var rem = document.getElementById("rememberMe");
            if (rem) rem.checked = false;
            var alertBox = document.getElementById("loginAlert");
            if (alertBox) {
                alertBox.textContent = "";
                alertBox.classList.add("d-none");
            }
            var btn = document.getElementById("clientLoginBtn");
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập';
            }
        }

        function toggleLoginPasswordVisibility() {
            var p = document.getElementById("clientLoginPass");
            var icon = document.getElementById("loginPassToggleIcon");
            if (!p || !icon) return;
            if (p.type === "password") {
                p.type = "text";
                icon.className = "bi bi-eye-slash";
            } else {
                p.type = "password";
                icon.className = "bi bi-eye";
            }
        }

        // Xóa trắng form đăng ký, ngăn trình duyệt tự động điền tài khoản khác
        function clearRegisterForm() {
            var f = document.getElementById("clientRegisterForm");
            if (f) f.reset();
            var fn = document.getElementById("regFullName"); if (fn) fn.value = "";
            var un = document.getElementById("regUserName"); if (un) un.value = "";
            var em = document.getElementById("regEmail"); if (em) em.value = "";
            var pw = document.getElementById("regPassword"); if (pw) pw.value = "";
            var cpw = document.getElementById("regConfirmPassword"); if (cpw) cpw.value = "";
            var alertBox = document.getElementById("registerAlert"); if (alertBox) alertBox.classList.add("d-none");
            var successBox = document.getElementById("registerSuccessBox"); if (successBox) successBox.classList.add("d-none");
            if (f) f.classList.remove("d-none");
            var alreadyText = document.getElementById("alreadyHaveAccountText"); if (alreadyText) alreadyText.classList.remove("d-none");
            resetAuthSteps();
        }

        // Thiết lập lại tiến trình các bước đăng ký
        function resetAuthSteps() {
            var s1 = document.getElementById("authStep1");
            var s2 = document.getElementById("authStep2");
            var s3 = document.getElementById("authStep3");
            if (s1) {
                s1.className = "d-flex align-items-center gap-1 text-primary fw-bold";
                var b1 = s1.querySelector(".badge"); if (b1) b1.className = "badge rounded-circle bg-primary text-white";
            }
            if (s2) {
                s2.className = "d-flex align-items-center gap-1 text-muted";
                var b2 = s2.querySelector(".badge"); if (b2) b2.className = "badge rounded-circle bg-secondary text-white";
            }
            if (s3) {
                s3.className = "d-flex align-items-center gap-1 text-muted";
                var b3 = s3.querySelector(".badge"); if (b3) b3.className = "badge rounded-circle bg-secondary text-white";
            }
        }

        // Chuyển đổi qua lại giữa tab Đăng Nhập và Đăng Ký
        function switchAuthTab(tab) {
            if (tab === 'register') {
                var regBtn = document.getElementById('tab-register-btn');
                if (regBtn) {
                    var trigger = new bootstrap.Tab(regBtn);
                    trigger.show();
                }
                onSwitchAuthMode('register');
            } else {
                var loginBtn = document.getElementById('tab-login-btn');
                if (loginBtn) {
                    var trigger = new bootstrap.Tab(loginBtn);
                    trigger.show();
                }
                onSwitchAuthMode('login');
            }
        }

        // Đăng ký sự kiện reset khi mở Modal
        document.addEventListener("DOMContentLoaded", function() {
            clearLoginForm();
            var authModalEl = document.getElementById('loginModal');
            if (authModalEl) {
                authModalEl.addEventListener('show.bs.modal', function() {
                    clearLoginForm();
                    clearRegisterForm();
                });
                authModalEl.addEventListener('shown.bs.modal', function() {
                    var regTab = document.getElementById('tab-register');
                    if (regTab && regTab.classList.contains('active')) {
                        clearRegisterForm();
                    } else {
                        clearLoginForm();
                        setTimeout(clearLoginForm, 60);
                    }
                });
            }

            @if (TempData["AuthError"] != null)
            {
                <text>
                openAuthModal('login');
                setTimeout(function() {
                    var loginAlertEl = document.getElementById('loginAlert');
                    if (loginAlertEl) {
                        loginAlertEl.textContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["AuthError"]?.ToString()));
                        loginAlertEl.classList.remove('d-none');
                    }
                }, 120);
                </text>
            }
        });

        // Xử lý đăng ký tài khoản từ trang chủ khách
        function handleClientRegister(e) {
            e.preventDefault();
            var fullName = document.getElementById("regFullName").value.trim();
            var userName = document.getElementById("regUserName").value.trim();
            var email = document.getElementById("regEmail").value.trim();
            var password = document.getElementById("regPassword").value;
            var confirmPassword = document.getElementById("regConfirmPassword").value;
            var alertBox = document.getElementById("registerAlert");
            var btn = document.getElementById("clientRegisterBtn");

            alertBox.className = "alert alert-danger d-none rounded-3 py-2 px-3 small";

            if (password !== confirmPassword) {
                alertBox.textContent = "Mật khẩu xác nhận không khớp! Vui lòng nhập lại.";
                alertBox.classList.remove("d-none");
                return;
            }

            if (password.length < 6) {
                alertBox.textContent = "Mật khẩu phải có độ dài tối thiểu 6 ký tự!";
                alertBox.classList.remove("d-none");
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang xử lý & cấp mã...';

            // Tiến trình bước 2: Đang cấp mã
            var s2 = document.getElementById("authStep2");
            if (s2) {
                s2.className = "d-flex align-items-center gap-1 text-primary fw-bold";
                var b2 = s2.querySelector(".badge"); if (b2) b2.className = "badge rounded-circle bg-primary text-white";
            }

            var formData = new FormData();
            formData.append("fullName", fullName);
            formData.append("userName", userName);
            formData.append("email", email);
            formData.append("password", password);
            formData.append("confirmPassword", confirmPassword);

            fetch('/Home/Register', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    // Tiến trình bước 3: Xác thực thành công
                    var s3 = document.getElementById("authStep3");
                    if (s3) {
                        s3.className = "d-flex align-items-center gap-1 text-success fw-bold";
                        var b3 = s3.querySelector(".badge"); if (b3) b3.className = "badge rounded-circle bg-success text-white";
                    }

                    // Ẩn form và hiển thị Card trạng thái xác thực tài khoản
                    document.getElementById("clientRegisterForm").classList.add("d-none");
                    var alreadyText = document.getElementById("alreadyHaveAccountText");
                    if (alreadyText) alreadyText.classList.add("d-none");

                    document.getElementById("cardUserCode").textContent = data.userCode || "DG0001";
                    document.getElementById("cardFullName").textContent = data.fullName || fullName;
                    document.getElementById("cardUserName").textContent = data.userName || userName;
                    document.getElementById("cardRole").textContent = data.role || "Độc giả (Reader)";

                    var successBox = document.getElementById("registerSuccessBox");
                    if (successBox) successBox.classList.remove("d-none");

                    setTimeout(() => {
                        window.location.href = data.redirectUrl || '/';
                    }, 2600);
                } else {
                    resetAuthSteps();
                    alertBox.className = "alert alert-danger rounded-3 py-2 px-3 small";
                    alertBox.textContent = data.message || "Đăng ký thất bại, vui lòng thử lại!";
                    alertBox.classList.remove("d-none");
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-person-check me-1"></i> Hoàn Tất Đăng Ký';
                }
            })
            .catch(err => {
                resetAuthSteps();
                alertBox.className = "alert alert-danger rounded-3 py-2 px-3 small";
                alertBox.textContent = "Có lỗi kết nối máy chủ, vui lòng thử lại!";
                alertBox.classList.remove("d-none");
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-person-check me-1"></i> Hoàn Tất Đăng Ký';
            });
        }

        // Xử lý đăng nhập từ trang chủ khách (chỉ gửi khi người dùng tự nhập và bấm Đăng Nhập)
        function handleClientLogin(e) {
            e.preventDefault();
            var userEl = document.getElementById("clientLoginUser");
            var passEl = document.getElementById("clientLoginPass");
            var remEl = document.getElementById("rememberMe");
            var alertBox = document.getElementById("loginAlert");
            var btn = document.getElementById("clientLoginBtn");

            var user = userEl ? userEl.value.trim() : "";
            var pass = passEl ? passEl.value : "";
            var rememberMe = remEl ? remEl.checked : false;

            alertBox.classList.add("d-none");

            if (!user || !pass.trim()) {
                alertBox.textContent = "Vui lòng nhập đầy đủ tên đăng nhập và mật khẩu!";
                alertBox.classList.remove("d-none");
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang xác thực...';

            var formData = new FormData();
            formData.append("userName", user);
            formData.append("password", pass);
            formData.append("rememberMe", rememberMe);

            fetch('/Home/Login', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    window.location.href = data.redirectUrl || '/';
                } else {
                    alertBox.textContent = data.message || "Tên đăng nhập hoặc mật khẩu không chính xác!";
                    alertBox.classList.remove("d-none");
                    if (passEl) passEl.value = "";
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập';
                }
            })
            .catch(err => {
                alertBox.textContent = "Có lỗi kết nối máy chủ, vui lòng thử lại!";
                alertBox.classList.remove("d-none");
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập';
            });
        }

        // Xử lý tra cứu phiếu mượn & trả sách qua API
        function searchTicketAction() {
            var input = document.getElementById("ticketSearchInput");
            var code = input.value.trim();
            var alertBox = document.getElementById("ticketSearchAlert");
            var tbody = document.getElementById("ticketResultBody");
            var btn = document.getElementById("btnTicketSearch");

            alertBox.classList.add("d-none");

            if (!code) {
                alertBox.textContent = "Vui lòng nhập Mã phiếu mượn (PM...), Mã trả (PT...) hoặc Mã bạn đọc (DG...)!";
                alertBox.classList.remove("d-none");
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang tra...';

            fetch('/Home/SearchTicket?keyword=' + encodeURIComponent(code))
            .then(res => res.json())
            .then(data => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-search me-1"></i> Tra cứu';

                if (data.success && data.data && data.data.length > 0) {
                    var html = "";
                    data.data.forEach(item => {
                        var returnBadge = item.status === "Đã trả" 
                            ? '<span class="badge" style="background: #ecfdf5; color: #059669; font-weight: 700;">' + item.returnCode + '</span>'
                            : '<span class="text-muted small">---</span>';

                        var statusBadge = item.status === "Đã trả"
                            ? '<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">Đã trả</span>'
                            : '<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3">Đang mượn</span>';

                        html += '<tr>' +
                            '<td><span class="badge" style="background: #eef2ff; color: #4338ca; font-weight: 700;">' + item.ticketCode + '</span></td>' +
                            '<td>' + returnBadge + '</td>' +
                            '<td><strong>' + item.bookTitle + '</strong></td>' +
                            '<td><span class="badge bg-light text-dark border me-1">' + item.userCode + '</span> ' + item.userName + '</td>' +
                            '<td>' + item.borrowDate + '</td>' +
                            '<td>' + item.dueDate + '</td>' +
                            '<td>' + statusBadge + '</td>' +
                        '</tr>';
                    });
                    tbody.innerHTML = html;
                } else {
                    alertBox.textContent = data.message || "Không tìm thấy dữ liệu phù hợp!";
                    alertBox.classList.remove("d-none");
                }
            })
            .catch(err => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-search me-1"></i> Tra cứu';
                alertBox.textContent = "Có lỗi kết nối máy chủ, vui lòng thử lại!";
                alertBox.classList.remove("d-none");
            });
        }

        function escapeNotifHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function updateReaderNotificationBadge(unreadCount) {
            var badge = document.getElementById('readerNotificationBadge');
            if (!badge) return;
            if (unreadCount > 0) {
                badge.textContent = unreadCount > 99 ? '99+' : unreadCount;
                badge.classList.remove('d-none');
            } else {
                badge.textContent = '0';
                badge.classList.add('d-none');
            }
        }

        function loadReaderNotifications() {
            var listEl = document.getElementById('readerNotificationList');
            if (!listEl) return;

            fetch('/Notification/GetMyNotifications')
                .then(res => res.json())
                .then(data => {
                    if (!data.success) return;
                    updateReaderNotificationBadge(data.unreadCount || 0);

                    if (!data.items || data.items.length === 0) {
                        listEl.innerHTML = '<div class="text-center text-muted py-4 px-3 small"><i class="bi bi-bell-slash d-block fs-4 mb-1 opacity-50"></i>Bạn chưa có thông báo nhắc nhở nào.</div>';
                        return;
                    }

                    var html = '';
                    data.items.forEach(function (item) {
                        var bgClass = item.isRead ? 'bg-white' : 'bg-primary-subtle bg-opacity-25';
                        var dotHtml = item.isRead
                            ? ''
                            : '<span class="badge bg-danger rounded-circle p-1 me-1" title="Chưa đọc" style="width:8px;height:8px;display:inline-block;"></span>';
                        var sevBadge = item.severityLevel === 'Nghiêm trọng'
                            ? 'bg-danger-subtle text-danger'
                            : (item.severityLevel === 'Cảnh báo' ? 'bg-warning-subtle text-warning-emphasis' : 'bg-info-subtle text-info-emphasis');

                        var markBtn = item.isRead
                            ? '<span class="text-muted" style="font-size:11px;"><i class="bi bi-check2-all"></i> Đã đọc</span>'
                            : '<button type="button" class="btn btn-link btn-sm p-0 text-primary text-decoration-none" style="font-size:11px;" onclick="markReaderNotificationRead(event, ' + item.notificationID + ', false)"><i class="bi bi-check2"></i> Đánh dấu đã đọc</button>';

                        html += '<div class="p-3 border-bottom ' + bgClass + '" style="cursor:pointer; transition: background 0.15s;" onclick="openReaderNotification(' + item.notificationID + ', ' + (item.isRead ? 'true' : 'false') + ')">'
                            + '<div class="d-flex justify-content-between align-items-start gap-2 mb-1">'
                            + '<div class="fw-bold text-dark small">' + dotHtml + escapeNotifHtml(item.title) + '</div>'
                            + '<span class="badge ' + sevBadge + ' rounded-pill flex-shrink-0" style="font-size:10px;">' + escapeNotifHtml(item.severityLevel) + '</span>'
                            + '</div>'
                            + '<div class="small text-secondary mb-1"><strong>Sách:</strong> ' + escapeNotifHtml(item.bookTitles) + '</div>'
                            + '<div class="d-flex flex-wrap gap-2 text-muted mb-2" style="font-size:11.5px;">'
                            + '<span><i class="bi bi-ticket-perforated"></i> Mã phiếu: <strong>' + escapeNotifHtml(item.ticketCode) + '</strong></span>'
                            + '<span class="text-danger"><i class="bi bi-clock-history"></i> Quá hạn: <strong>' + item.overdueDays + ' ngày</strong></span>'
                            + '<span><i class="bi bi-calendar-event"></i> Hạn trả: <strong>' + escapeNotifHtml(item.dueDate) + '</strong></span>'
                            + '</div>'
                            + '<div class="d-flex justify-content-between align-items-center">'
                            + '<span class="text-muted" style="font-size:11px;">' + escapeNotifHtml(item.createdDate) + '</span>'
                            + markBtn
                            + '</div>'
                            + '</div>';
                    });

                    listEl.innerHTML = html;
                })
                .catch(function () {
                    listEl.innerHTML = '<div class="text-center text-danger py-3 small">Không thể tải thông báo.</div>';
                });
        }

        function markReaderNotificationRead(e, id, redirectAfter) {
            if (e) e.stopPropagation();
            fetch('/Notification/MarkAsRead?id=' + encodeURIComponent(id), {
                method: 'POST'
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        updateReaderNotificationBadge(data.unreadCount || 0);
                        if (redirectAfter) {
                            window.location.href = '/Profile';
                        } else {
                            loadReaderNotifications();
                        }
                    } else if (redirectAfter) {
                        window.location.href = '/Profile';
                    }
                })
                .catch(function () {
                    if (redirectAfter) window.location.href = '/Profile';
                });
        }

        function openReaderNotification(id, isRead) {
            if (isRead) {
                window.location.href = '/Profile';
                return;
            }
            markReaderNotificationRead(null, id, true);
        }

        function markAllReaderNotificationsRead() {
            fetch('/Notification/MarkAllAsRead', {
                method: 'POST'
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        updateReaderNotificationBadge(0);
                        loadReaderNotifications();
                    }
                });
        }

        document.addEventListener('DOMContentLoaded', function () {
            var bellBtn = document.getElementById('readerNotificationBtn');
            if (bellBtn) {
                loadReaderNotifications();
                bellBtn.addEventListener('show.bs.dropdown', function () {
                    loadReaderNotifications();
                });
            }
        });
    </script>

</body>
</html>
