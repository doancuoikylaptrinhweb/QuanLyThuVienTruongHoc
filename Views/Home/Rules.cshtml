@{
    ViewData["Title"] = "Nội Quy Mượn Trả Sách - Thư Viện Số";
}

<div class="page-banner-header">
    <span class="badge bg-white bg-opacity-25 text-white rounded-pill px-3 py-2 mb-2">
        <i class="bi bi-journal-text me-1"></i> QUY ĐỊNH THƯ VIỆN
    </span>
    <h1 class="fw-bold mb-2" style="font-size: 2rem;">Nội Quy Mượn &amp; Trả Tài Liệu</h1>
    <p class="text-white-50 mb-0">Hướng dẫn chi tiết quyền lợi, trách nhiệm và quy trình mượn trả sách dành cho bạn đọc.</p>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-6 col-lg-3">
        <div class="section-surface h-100">
            <div class="rounded-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px; background: #eff6ff; color: #2563eb; font-size: 22px;">
                <i class="bi bi-person-vcard"></i>
            </div>
            <h5 class="fw-bold">1. Đối tượng phục vụ</h5>
            <p class="text-muted small mb-0">Học sinh, sinh viên, giảng viên và cán bộ có tài khoản Bạn đọc (mã <code>DGxxxx</code>) đang hoạt động trên hệ thống.</p>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="section-surface h-100">
            <div class="rounded-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px; background: #f5f3ff; color: #7c3aed; font-size: 22px;">
                <i class="bi bi-book"></i>
            </div>
            <h5 class="fw-bold">2. Hạn mức mượn</h5>
            <p class="text-muted small mb-0">Mỗi bạn đọc được mượn tối đa <strong>3 cuốn sách</strong> cùng lúc trong thời hạn tiêu chuẩn <strong>14 ngày</strong>.</p>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="section-surface h-100">
            <div class="rounded-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px; background: #ecfdf5; color: #16a34a; font-size: 22px;">
                <i class="bi bi-arrow-repeat"></i>
            </div>
            <h5 class="fw-bold">3. Quy trình trả sách</h5>
            <p class="text-muted small mb-0">Bạn đọc gửi yêu cầu trả sách tại trang <a href="/Profile">Hồ sơ &amp; Phiếu mượn</a> và bàn giao sách nguyên vẹn tại quầy Thủ thư để xác nhận hoàn kho.</p>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="section-surface h-100">
            <div class="rounded-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px; background: #fef2f2; color: #dc2626; font-size: 22px;">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <h5 class="fw-bold">4. Quá hạn &amp; Bảo quản</h5>
            <p class="text-muted small mb-0">Không làm rách, viết vẽ lên sách. Khi có phiếu quá hạn chưa trả, hệ thống sẽ tạm khóa quyền mượn sách mới cho đến khi hoàn tất trả.</p>
        </div>
    </div>
</div>

<div class="section-surface d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h5 class="fw-bold mb-1">Sẵn sàng tìm kiếm tài liệu học tập?</h5>
        <p class="text-muted small mb-0">Tra cứu hàng nghìn đầu sách sẵn sàng trên kệ hoặc kiểm tra phiếu mượn của bạn.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Lookup" class="btn btn-primary rounded-pill px-4 fw-semibold">Tra cứu sách ngay</a>
        <a href="/Borrow/Lookup" class="btn btn-outline-primary rounded-pill px-4 fw-semibold">Tra cứu phiếu mượn</a>
    </div>
</div>
