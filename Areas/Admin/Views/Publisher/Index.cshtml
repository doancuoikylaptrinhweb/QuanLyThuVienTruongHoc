@using LibraryManagement.Models
@model IList<tblPublisher>

@{
    ViewData["Title"] = "Quản Lý Nhà Xuất Bản";
    var bookCounts = ViewBag.BookCounts as Dictionary<int, int>;
}

<main id="main" class="main">

    <!-- Page Header & Action -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm" 
                 style="width: 44px; height: 44px; background: #2563eb; font-size: 20px;">
                <i class="bi bi-building-fill"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-0 text-dark" style="font-size: 22px; letter-spacing: -0.3px;">Quản Lý Nhà Xuất Bản</h4>
                <small class="text-muted" style="font-size: 13px;">
                    Thông tin các đối tác xuất bản sách, địa chỉ trụ sở và số điện thoại liên hệ
                </small>
            </div>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-area="Admin" asp-controller="Publisher" asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm d-flex align-items-center gap-2">
                <i class="bi bi-plus-circle-fill"></i> Thêm Nhà Xuất Bản
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <!-- Search bar -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <form method="get" class="d-flex gap-2 flex-grow-1" style="max-width: 450px;">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control border-start-0 ps-0" placeholder="Tìm theo tên NXB, địa chỉ, số điện thoại..." />
                </div>
                <button type="submit" class="btn btn-primary rounded-pill px-3">Tìm</button>
                @if (!string.IsNullOrEmpty(ViewBag.Keyword))
                {
                    <a href="/Admin/Publisher" class="btn btn-outline-secondary rounded-pill px-3">Xóa lọc</a>
                }
            </form>
            <div class="text-muted small">
                Tổng cộng: <strong>@Model.Count</strong> nhà xuất bản
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 13.5px;">
                <thead>
                    <tr class="text-muted text-uppercase" style="font-size: 11px; letter-spacing: 0.6px; border-bottom: 2px solid #f1f5f9;">
                        <th class="py-2 text-center" style="width: 60px;"># ID</th>
                        <th class="py-2" style="width: 250px;">TÊN NHÀ XUẤT BẢN</th>
                        <th class="py-2">ĐỊA CHỈ TRỤ SỞ</th>
                        <th class="py-2" style="width: 150px;">HOTLINE / SĐT</th>
                        <th class="py-2 text-center" style="width: 140px;">SỐ ĐẦU SÁCH</th>
                        <th class="py-2 text-center" style="width: 120px;">CHỨC NĂNG</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                Không tìm thấy nhà xuất bản nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            int count = bookCounts != null && bookCounts.ContainsKey(item.PublisherID) ? bookCounts[item.PublisherID] : 0;
                            <tr>
                                <td class="text-center fw-semibold text-secondary">#@item.PublisherID</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-primary" style="width: 32px; height: 32px; background: #eff6ff;">
                                            <i class="bi bi-building"></i>
                                        </div>
                                        <strong class="text-dark">@item.PublisherName</strong>
                                    </div>
                                </td>
                                <td class="text-secondary">
                                    @(string.IsNullOrEmpty(item.Address) ? "Chưa có địa chỉ" : item.Address)
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Phone))
                                    {
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-telephone text-primary me-1"></i> @item.Phone
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa có</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge" style="background: #eef2ff; color: #4338ca; font-weight: 600; padding: 6px 12px; border-radius: 50px;">
                                        @count đầu sách
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex gap-1">
                                        <!-- Sửa -->
                                        <a asp-area="Admin" asp-controller="Publisher" asp-action="Edit" asp-route-id="@item.PublisherID" 
                                           class="btn btn-sm btn-light border text-primary rounded-circle" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;" title="Sửa NXB">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>

                                        <!-- Xóa -->
                                        <a asp-area="Admin" asp-controller="Publisher" asp-action="Delete" asp-route-id="@item.PublisherID" 
                                           class="btn btn-sm btn-light border text-danger rounded-circle" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;" title="Xóa NXB">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</main>
